---
import '../styles/global.css';
import FontSwitcher from '../components/FontSwitcher.astro';
import Seo from '@jw/shared/components/Seo.astro';
import { brokerageJsonLd } from '@jw/shared/jsonLd';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: string;
  /** Page-specific JSON-LD (e.g. RealEstateListing + breadcrumb); merged with
   *  the sitewide brokerage block emitted on every page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = `${site.name} | Triangle Area Real Estate`,
  description = site.description,
  image,
  imageAlt,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const currentPath = Astro.url.pathname;
// Staging builds (SITE_ENV=staging) emit a noindex meta so search engines never
// index the staging host. These pages are prerendered, so this is read at BUILD
// time — the Coolify staging app passes SITE_ENV as a build arg (see Dockerfile).
// Belt-and-suspenders with the SSR robots.txt, which blocks crawling at runtime.
const isStaging = process.env.SITE_ENV === 'staging';
// Canonical from the configured site host (astro.config `site`), NOT the request
// origin — so the canonical never floats to whatever hostname a crawler used and
// always agrees with og:image/og:url below. Query strings are dropped by design.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// Social share image. Pages pass a root-relative path or an absolute URL
// (listing detail passes the listing's primary photo); both are resolved to an
// absolute URL because social crawlers reject relative paths. Falls back to the
// branded 1200×630 card. Rename the default file (not just its contents) to bust
// LinkedIn's ~7-day preview cache.
const DEFAULT_OG_IMAGE = '/images/og-default.png';
const ogImageUrl = new URL(image ?? DEFAULT_OG_IMAGE, Astro.site ?? Astro.url).href;

// Sitewide brokerage identity (one RealEstateAgent block on every page). Uses
// the canonical production host regardless of environment so the identity is
// stable. Page-provided JSON-LD is appended after it.
const brokerage = brokerageJsonLd({
  name: 'Julie Wright Realty Group LLC',
  url: site.url,
  licenseNumber: 'C29156',
  street: `${site.address.street1}, ${site.address.street2}`,
  city: site.address.city,
  region: site.address.state,
  postalCode: '27615-2085',
  areaServed: site.counties.map((c) => `${c} County, NC`),
});
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const jsonLdBlocks = [brokerage, ...pageJsonLd];

// Flat top-level nav — deeper pages are reached from each section landing page.
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/listings', label: 'Listings' },
  { href: '/neighborhoods', label: 'Neighborhoods' },
  { href: '/resources', label: 'Resources' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const footerNav = [
  { href: '/listings', label: 'Listings' },
  { href: '/search', label: 'Property Search' },
  { href: '/neighborhoods', label: 'Neighborhoods' },
  { href: '/neighborhood-map', label: 'Neighborhood Map' },
  { href: '/resources', label: 'Resources' },
  { href: '/about', label: 'About' },
  { href: '/about#team', label: 'Our Team' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {isStaging && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Warm the connection to the office host up front: every listing, team, and
         neighborhood photo is served from office.jwrgnc.com, so opening the TLS
         handshake early shaves it off the first image request (the island grids
         paint their images as soon as the fragment arrives). dns-prefetch is the
         fallback for browsers that ignore preconnect. -->
    <link rel="preconnect" href="https://office.jwrgnc.com" crossorigin />
    <link rel="dns-prefetch" href="https://office.jwrgnc.com" />
    <Seo
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      siteName={site.name}
      image={ogImageUrl}
      imageAlt={imageAlt}
      ogType={ogType}
      jsonLd={jsonLdBlocks}
    />
    <!-- Self-hosted brand fonts (@font-face lives in global.css). Preload the two
         above-the-fold latin variable faces so headings/body paint without a flash
         and with no third-party font request in the critical path. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/gabarito-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/anek-latin-latin.woff2" crossorigin />
    <!-- Umami analytics (self-hosted, cookieless — no consent banner needed). -->
    <script is:inline defer src="https://analytics.jwrgnc.com/script.js" data-website-id="abf106f7-064f-496a-98ee-5e4c5726ba4b"></script>
  </head>
  <body class="site-body">
    <!-- Skip to main content -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Global topo background overlay -->
    <div class="topo-bg-wrap-fixed">
      <img src="/FallTopo_v2.svg" class="topo-bg" alt="" aria-hidden="true" />
    </div>

    <!-- Navigation -->
    <header class="site-header" id="site-header">
      <div class="header-bg" id="header-bg"></div>
      <nav class="site-nav" aria-label="Primary navigation">
        <!-- Logo (left) -->
        <a href="/" class="nav-logo">
          <div class="nav-logo-icon" role="img" aria-label={site.name}></div>
        </a>

        <!-- Desktop Nav (center) -->
        <ul class="nav-desktop">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'nav-desktop-link',
                    isActive ? 'nav-link-active' : 'nav-link-inactive',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span class="nav-link-bg" aria-hidden="true"></span>
                  {link.label}
                  {isActive && <span class="nav-active-bar" />}
                </a>
              </li>
            );
          })}
        </ul>

        <!-- Desktop search (deep-links into the /listings keyword filter) -->
        <form action="/listings" method="get" role="search" class="ml-auto hidden lg:block">
          <label for="nav-search" class="sr-only">Search listings</label>
          <div class="nav-search relative">
            <svg class="nav-search-icon pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input id="nav-search" name="q" type="search" placeholder="Search listings…" class="nav-search-input w-44 focus:w-60 py-1.5 pl-9 pr-3 text-sm focus:outline-none transition-all duration-300" />
          </div>
        </form>

        <!-- Mobile Menu Button -->
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-menu">
          <span class="sr-only">Menu</span>
          <div class="hamburger-wrap" aria-hidden="true">
            <span class="hamburger-bar" id="bar1"></span>
            <span class="hamburger-bar" id="bar2"></span>
            <span class="hamburger-bar" id="bar3"></span>
          </div>
        </button>
      </nav>

      <!-- Mobile Menu -->
      <div class="mobile-menu" id="mobile-menu" aria-hidden="true" inert>
        <form action="/listings" method="get" role="search" class="px-4 pt-3 pb-1">
          <label for="nav-search-mobile" class="sr-only">Search listings</label>
          <div class="nav-search relative">
            <svg class="nav-search-icon pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input id="nav-search-mobile" name="q" type="search" placeholder="Search listings…" class="nav-search-input w-full py-2 pl-9 pr-3 text-sm focus:outline-none transition-colors" />
          </div>
        </form>
        <ul class="mobile-menu-list">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href;
            return (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'mobile-menu-link',
                    isActive ? 'nav-link-active' : 'nav-link-inactive',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </header>

    <FontSwitcher />

    <!-- Main Content -->
    <main class="site-main" id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <img src="/FallTopo_v2.svg" class="topo-bg topo-bg--faint" alt="" aria-hidden="true" />
      <div class="footer-inner">
        <div class="footer-grid">
          <!-- Brand -->
          <div class="footer-brand">
            <a href="/" class="footer-logo">
              <img src="/JWRG_Full_White.svg" class="footer-logo-img" alt={`${site.name} — home`} />
            </a>
            <p class="footer-tagline">
              Five decades guiding Triangle-area families home — full-service residential real estate
              across the greater Triangle region and surrounding counties.
            </p>

            <!-- Affiliation / compliance marks (Equal Housing Opportunity + REALTOR®).
                 Single-color official SVGs recolored to the footer palette via CSS mask —
                 source files live in jw-design-guide (public/affiliations/). -->
            <div class="footer-affiliations">
              <span class="footer-affiliation" role="img" aria-label="Equal Housing Opportunity">
                <span class="footer-affiliation-mark footer-affiliation-mark--eho"></span>
              </span>
              <span class="footer-affiliation" role="img" aria-label="REALTOR&reg;">
                <span class="footer-affiliation-mark footer-affiliation-mark--realtor"></span>
              </span>
            </div>
          </div>

          <!-- Quick Links -->
          <nav aria-label="Footer navigation">
            <h3 class="footer-col-heading">Navigate</h3>
            <ul class="footer-nav-list">
              {footerNav.map((link) => (
                <li>
                  <a href={link.href} class="footer-nav-link">{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>

          <!-- Services -->
          <div>
            <h3 class="footer-col-heading">How We Help</h3>
            <ul class="footer-services-list">
              <li>Buying a Home</li>
              <li>Selling a Home</li>
              <li>Relocation Services</li>
              <li>New Construction</li>
              <li>Neighborhood Expertise</li>
              <li>Market & Home Valuations</li>
            </ul>
          </div>

          <!-- Contact -->
          <div>
            <h3 class="footer-col-heading">Contact</h3>
            <address class="footer-contact">
              <p>{site.address.street1}{site.address.street2 ? `, ${site.address.street2}` : ''}<br />{site.address.city}, {site.address.state} {site.address.zip}</p>
              <p>
                <a href={`tel:${site.phoneRaw}`} class="footer-contact-link">{site.phone}</a>
              </p>
              <p>
                <a href={`mailto:${site.email}`} class="footer-contact-link">{site.email}</a>
              </p>
            </address>
          </div>
        </div>

        <div class="footer-bottom">
          <p class="footer-copyright">&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</p>
          <p class="footer-location">Raleigh, NC &middot; Serving the Triangle for 50+ Years</p>
        </div>
      </div>
    </footer>

    <script>
      import { captureSource } from '../lib/source';

      // Stash ref/utm_* landing params for form-submission attribution.
      captureSource();

      // Respect the user's reduced-motion preference for every JS-driven motion
      // below (topo parallax, nav press animation, smooth scroll). CSS-level
      // transitions are already zeroed by the shared reduced-motion block, but
      // scroll-driven transforms can only be stopped here.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      // Topo width — zoom-independent
      // outerWidth is in layout pixels (unaffected by zoom); innerWidth is in CSS pixels (zoom-dependent).
      // We size the SVG in layout pixels, then convert to CSS pixels so it stays physically constant.
      function updateTopoWidth() {
        const outer = window.outerWidth;
        const inner = window.innerWidth;
        const physicalW = Math.max(2160, outer / 0.95); // layout pixels
        const cssW = physicalW * inner / outer;          // convert to CSS pixels
        document.documentElement.style.setProperty('--topo-width', `${Math.round(cssW)}px`);
      }
      let resizeTimer: ReturnType<typeof setTimeout> | null = null;
      function scheduleResize() {
        if (!resizeTimer) {
          document.querySelectorAll<HTMLElement>('.topo-bg').forEach(el => el.style.visibility = 'hidden');
        }
        clearTimeout(resizeTimer!);
        resizeTimer = setTimeout(() => {
          updateTopoWidth();
          if (!reduceMotion.matches) updateParallax();
          document.querySelectorAll<HTMLElement>('.topo-bg').forEach(el => el.style.visibility = '');
          resizeTimer = null;
        }, 150);
      }

      updateTopoWidth();
      window.addEventListener('resize', scheduleResize);

      // Topo SVG parallax — seamless across sections, scrolls slower than page
      const PARALLAX_SPEED = 0.3; // fraction of scroll speed (0 = with page, 1 = fixed to viewport)
      function updateParallax() {
        const scrollY = window.scrollY;
        const vpH = window.innerHeight;
        const elements = document.querySelectorAll<HTMLElement>('.topo-bg');
        if (!elements.length) return;

        const svgHeight = elements[0].offsetHeight;

        // Raw target: SVG center drifts upward at PARALLAX_SPEED as page scrolls
        const rawTargetVpY = vpH / 2 - scrollY * PARALLAX_SPEED;

        // Clamp so SVG edges never become visible:
        //   top edge clamped: targetVpY <= svgHeight / 2
        //   bottom edge clamped: targetVpY >= vpH - svgHeight / 2
        const targetVpY = Math.max(vpH - svgHeight / 2, Math.min(svgHeight / 2, rawTargetVpY));

        elements.forEach(el => {
          const section = el.parentElement;
          if (!section) return;
          const rect = section.getBoundingClientRect();
          const sectionCenterVpY = rect.top + rect.height / 2;
          const offset = targetVpY - sectionCenterVpY;
          el.style.transform = `translateX(-50%) translateY(calc(-50% + ${offset}px))`;
        });
      }

      let rafPending = false;
      function scheduleParallax() {
        if (!rafPending) {
          rafPending = true;
          requestAnimationFrame(() => { updateParallax(); rafPending = false; });
        }
      }

      if (!reduceMotion.matches) {
        updateParallax();
        window.addEventListener('scroll', scheduleParallax, { passive: true });
      }

      // Nav press animation. We do NOT hijack navigation — the browser handles
      // the click natively, so Cmd/Ctrl/Shift-click (open in new tab/window),
      // middle-click, and keyboard Enter all behave correctly and without delay.
      // The press animation just plays over the top while the next page loads.
      document.querySelectorAll<HTMLAnchorElement>('.nav-desktop-link').forEach(link => {
        link.addEventListener('click', (e) => {
          // Let the browser own modified / non-primary clicks and reduced-motion.
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          if (reduceMotion.matches) return;

          // Deactivate current active link
          const activeLink = document.querySelector<HTMLElement>('.nav-link-active');
          if (activeLink && activeLink !== link) {
            activeLink.classList.add('nav-link-deactivating');
          }

          // Drive click animation via inline styles so hover/CSS specificity can't interfere
          const bg = link.querySelector<HTMLElement>('.nav-link-bg');
          if (bg) {
            // Snap to start state (scaleY 0, gold, no transition)
            bg.style.transition = 'none';
            bg.style.backgroundColor = 'var(--color-gold-300)';
            bg.style.transform = 'scaleY(0)';
            bg.style.opacity = '1';
            // Next frame: re-enable transition and animate to full height
            requestAnimationFrame(() => {
              bg.style.transition = 'transform 100ms ease';
              bg.style.transform = 'scaleY(1)';
            });
          }

          link.classList.add('nav-link-clicking');
        });
      });

      // Mobile menu
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      function setMenuOpen(open: boolean) {
        menuBtn?.classList.toggle('open', open);
        mobileMenu?.classList.toggle('open', open);
        menuBtn?.setAttribute('aria-expanded', String(open));
        mobileMenu?.setAttribute('aria-hidden', String(!open));
        // `inert` keeps the collapsed panel's search + links out of the tab order
        // (it's only visually hidden via clip-path, not display:none).
        if (mobileMenu) mobileMenu.inert = !open;
      }

      // Start collapsed: not tabbable, not exposed to AT.
      if (mobileMenu) mobileMenu.inert = true;

      menuBtn?.addEventListener('click', () => {
        const open = !menuBtn.classList.contains('open');
        setMenuOpen(open);
        // Move focus into the panel on open; restore it to the button on close.
        if (open) mobileMenu?.querySelector<HTMLElement>('a, input, button')?.focus();
        else menuBtn.focus();
      });

      // Escape closes the menu and returns focus to the toggle.
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menuBtn?.classList.contains('open')) {
          setMenuOpen(false);
          menuBtn.focus();
        }
      });
    </script>
  </body>
</html>
