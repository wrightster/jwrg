---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import MiniContactForm from '../../components/MiniContactForm.astro';
import { fetchNeighborhoods, fetchListings, photoSrc, photoSrcSet } from '../../lib/api';

const neighborhoods = await fetchNeighborhoods().catch(() => []);

// Order neighborhoods by their most recent listing (newest first). Only those
// that actually have listings need a lookup — the rest keep their original
// order at the bottom — so this is usually just one small (memoized) call.
const latestListingBySlug = new Map<string, string>();
await Promise.all(
  neighborhoods
    .filter((n) => (n.listings_count ?? 0) > 0)
    .map(async (n) => {
      const listings = await fetchListings({ neighborhood: n.slug, perPage: 100 });
      const latest = listings
        .map((l) => l.list_date)
        .filter((d): d is string => Boolean(d))
        .sort()
        .at(-1);
      if (latest) latestListingBySlug.set(n.slug, latest);
    }),
);
const sortedNeighborhoods = [...neighborhoods].sort((a, b) => {
  const da = latestListingBySlug.get(a.slug);
  const db = latestListingBySlug.get(b.slug);
  if (da && db) return db.localeCompare(da); // both listed → newest first
  if (da) return -1; // a is listed, b isn't → a first
  if (db) return 1;
  return 0; // neither listed → keep original API order
});

// Neighborhoods that display a brand logo (from public/images/neighborhoods/)
// over the site background instead of an API photo. `scale` optically balances
// the marks so they read at a similar size in the card. Each logo was rendered
// and measured on two axes — bounding-box extent (how far it spans) and ink
// mass (how bold/dense it is) — because a logo looks "big" if it's large by
// EITHER (a wide thin wordmark, or a small bold emblem). Perceived size = the
// max of the two (each normalized across the set); heavier/wider marks scale
// down toward the lightest (preserve-west = 1.0). Recompute if artwork changes.
const localLogos: Record<string, { src: string; scale?: number }> = {
  'aubrie-place': { src: '/images/neighborhoods/aubrie-place.svg', scale: 0.86 },
  'bragg-farm': { src: '/images/neighborhoods/bragg-farm.svg', scale: 0.85 },
  'cannady-mill-rd-lots': { src: '/images/neighborhoods/cannady-mill-rd-lots.svg', scale: 0.78 },
  'cedar-knolls': { src: '/images/neighborhoods/cedar-knolls.svg', scale: 0.95 },
  'colvard-farms': { src: '/images/neighborhoods/colvard-farms.svg', scale: 0.79 },
  'preserve-west': { src: '/images/neighborhoods/preserve-west.svg' },
  'tennyson': { src: '/images/neighborhoods/tennyson.svg', scale: 0.90 },
  'woodland-park': { src: '/images/neighborhoods/woodland-park.svg', scale: 0.85 },
  'yancey-farms': { src: '/images/neighborhoods/yancey-farms.svg', scale: 0.92 },
};

const statusLabels: Record<string, string> = {
  planning: 'Planning',
  under_development: 'Under Development',
  active_sales: 'Active Sales',
  sold_out: 'Sold Out',
  established: 'Established',
};
---

<BaseLayout
  title="Neighborhoods | Julie Wright Realty Group"
  description="Triangle-area communities and subdivisions curated by Julie Wright Realty Group. Photos, amenities, HOA details, schools, and current listings for each."
>
  <PageBanner title="Our Neighborhoods" />

  <section class="py-20">
    <div class="max-w-7xl mx-auto px-6">
      {neighborhoods.length === 0 ? (
        <div class="text-center text-navy-500 py-16">
          <p>No neighborhoods are available right now. Please check back soon.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {sortedNeighborhoods.map((n) => {
            const heroSrc = photoSrc(n.primary_photo, 800);
            // Prefer the alpha-preserving webp: several neighborhood "photos" are
            // actually transparent logos, and the jpg conversion flattens them to
            // a black matte. webp keeps transparency so they sit on the light
            // card background instead.
            const heroWebp = photoSrcSet(n.primary_photo, 'webp');
            const location = [n.city, n.county && `${n.county} County`].filter(Boolean).join(' · ');
            // Some neighborhoods display a brand logo (over the site background)
            // instead of an API photo — see localLogos above.
            const logo = localLogos[n.slug];
            const logoPct = `${(logo?.scale ?? 1) * 100}%`;
            return (
              <a
                href={`/neighborhoods/${n.slug}`}
                class="group flex flex-col transition-transform duration-300 hover:-translate-y-1"
              >
                <div class="aspect-[4/3] relative overflow-hidden rounded-sm">
                  {logo ? (
                    <div class="w-full h-full flex items-center justify-center p-8">
                      <img
                        src={logo.src}
                        alt={n.name}
                        class="w-auto h-auto object-contain"
                        style={`max-width:${logoPct};max-height:${logoPct}`}
                        loading="lazy"
                      />
                    </div>
                  ) : heroSrc ? (
                    <picture class="contents">
                      {heroWebp && (
                        <source type="image/webp" srcset={heroWebp} sizes="(min-width:1280px) 25vw, (min-width:1024px) 33vw, (min-width:768px) 50vw, 100vw" />
                      )}
                      <img
                        src={heroSrc}
                        alt={n.primary_photo?.alt ?? n.name}
                        class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700"
                        loading="lazy"
                      />
                    </picture>
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <svg class="w-24 h-24 text-gold-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    </div>
                  )}
                  {n.status && n.status !== 'established' && n.status !== 'active_sales' && (
                    <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-semibold border bg-gold-500/90 text-white border-gold-400 backdrop-blur-sm">
                      {statusLabels[n.status]}
                    </span>
                  )}
                  {(n.listings_count ?? 0) > 0 && (
                    <span class="absolute bottom-4 right-4 px-3 py-1.5 rounded-sm text-xs font-semibold bg-navy-900/80 text-white backdrop-blur-sm">
                      {n.listings_count} listing{n.listings_count === 1 ? '' : 's'}
                    </span>
                  )}
                </div>
                <div class="pt-4 flex-1 flex flex-col">
                  {location && (
                    <div class="text-gold-600 text-xs tracking-widest uppercase mb-1">{location}</div>
                  )}
                  <h3 class="font-serif text-xl font-semibold text-navy-900 group-hover:text-gold-700 transition-colors">
                    {n.name}
                  </h3>
                  {(n.amenities?.length ?? 0) > 0 && (
                    <div class="mt-4 pt-4 border-t border-warm-200/60 flex flex-wrap gap-1.5 flex-1">
                      {n.amenities.slice(0, 3).map((a) => (
                        <span class="text-xs px-2 py-0.5 rounded-full bg-warm-100 text-navy-700">{a}</span>
                      ))}
                      {n.amenities.length > 3 && (
                        <span class="text-xs px-2 py-0.5 text-navy-500">+ {n.amenities.length - 3} more</span>
                      )}
                    </div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <MiniContactForm />
</BaseLayout>
