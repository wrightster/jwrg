---
// Prerendered shell: the neighborhood cards render live from the office API in
// a deferred server island (<NeighborhoodGrid server:defer>), so the banner and
// contact band paint instantly and the grid streams in behind its skeleton.
// This also moves the per-card lot-count fan-out (the old N+1) off the page's
// critical path — see src/components/NeighborhoodGrid.astro.
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import MiniContactForm from '../../components/MiniContactForm.astro';
import NeighborhoodGrid from '../../components/NeighborhoodGrid.astro';
import BtnArrow from '../../components/BtnArrow.astro';
---

<BaseLayout
  title="Neighborhoods | Julie Wright Realty Group"
  description="Triangle-area communities and subdivisions curated by Julie Wright Realty Group. Photos, amenities, HOA details, schools, and current listings for each."
>
  <PageBanner title="Our Neighborhoods" />

  <section class="py-8">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex justify-center mb-8">
        <BtnArrow href="/neighborhood-map" variant="secondary">See them on the map</BtnArrow>
      </div>
      <NeighborhoodGrid server:defer>
        <div slot="fallback" class="flex flex-wrap justify-center gap-x-6 -mb-6" aria-hidden="true">
          {Array.from({ length: 6 }).map(() => (
            <div class="flex flex-col mb-6 w-72 max-w-full shrink-0">
              <div class="aspect-[4/3] rounded-sm bg-earth-100 animate-pulse"></div>
              <div class="mx-auto mt-2 h-4 w-24 bg-earth-100 rounded animate-pulse"></div>
            </div>
          ))}
        </div>
      </NeighborhoodGrid>
    </div>
  </section>

  <MiniContactForm />
</BaseLayout>
