---
// SSR: individual homesite (lot) detail page, nested under its neighborhood.
// There's no single-lot API endpoint, so we fetch the neighborhood's lots (a
// 60s-memoized call the neighborhood page already primes) and find this one by
// lot_number. lot_number is only unique within a neighborhood, hence the route.
export const prerender = false;

import BaseLayout from '../../../../layouts/BaseLayout.astro';
import DocumentViewerModal from '../../../../components/DocumentViewerModal.astro';
import MiniContactForm from '../../../../components/MiniContactForm.astro';
import LotCard from '../../../../components/LotCard.astro';
import BtnArrow from '../../../../components/BtnArrow.astro';
import {
  fetchNeighborhood,
  fetchNeighborhoodLots,
  fetchNeighborhoodTeam,
  lotStatusMeta,
  lotTitle,
  lotAcresLabel,
  lotSqftLabel,
  lotPriceLabel,
  lotTypeLabel,
} from '../../../../lib/api';

const { slug, lot: lotParam } = Astro.params;
const n = slug ? await fetchNeighborhood(slug) : null;
if (!n) {
  return Astro.redirect('/neighborhoods');
}

const lots = await fetchNeighborhoodLots(n.slug);
// Agents flagged list_on_website for this community; [] falls back to the
// brokerage contact block in MiniContactForm.
const nbAgents = await fetchNeighborhoodTeam(n.slug);
const wanted = decodeURIComponent(lotParam ?? '').toLowerCase();
const lot = lots.find(
  (l) => l.status !== 'common_area' && String(l.lot_number).toLowerCase() === wanted,
);
if (!lot) {
  return Astro.redirect(`/neighborhoods/${n.slug}`);
}

const status = lotStatusMeta(lot.status);
const title = lotTitle(lot);
const acres = lotAcresLabel(lot);
const sqft = lotSqftLabel(lot);
const typeLabel = lotTypeLabel(lot.lot_type);
const hasPrice = lot.base_price != null && Number(lot.base_price) > 0;
const priceLabel = lotPriceLabel(lot);

const location = [n.city, n.county && `${n.county} County`].filter(Boolean).join(' · ');
// Office-authored copy wins over the generated sentence. Blank-line-separated
// paragraphs are preserved; the closing "reach out" line stays either way so a
// lot with copy still ends on a call to action.
const blurb = lot.marketing_description?.trim() || null;

// Marketing-safe documents attached to this lot (floor plans, spec sheets).
const documents = (lot.documents ?? []).filter((d) => d.url);
const humanizeType = (t: string | null): string | null =>
  t ? t.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) : null;

// A few other homesites to keep browsing (available first), excluding this one.
const siblings = lots
  .filter((l) => l.status !== 'common_area' && l.id !== lot.id)
  .sort((a, b) => Number(a.status !== 'available') - Number(b.status !== 'available'))
  .slice(0, 3);

const metaDescription =
  `${title} in ${n.name}` +
  (acres ? ` — ${acres}` : '') +
  (hasPrice ? `, ${priceLabel}` : '') +
  `. ${status.label} homesite offered by Julie Wright Realty Group.`;
---

<BaseLayout title={`${title} · ${n.name} | Julie Wright Realty Group`} description={metaDescription}>
  <div class="listing-back-bar">
    <div class="max-w-7xl mx-auto px-6 py-4">
      <a href={`/neighborhoods/${n.slug}`} class="listing-back-link">
        <svg class="listing-back-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        Back to {n.name}
      </a>
    </div>
  </div>

  <section class="pt-8 pb-4">
    <div class="max-w-7xl mx-auto px-6">
      <div class="listing-badges">
        <span class="listing-status-badge" data-status={status.colorKey}>{status.label}</span>
        <a href={`/neighborhoods/${n.slug}`} class="listing-county-badge hover:text-red-600 transition-colors">{n.name}</a>
      </div>
      <h1 class="listing-title">{title}</h1>
      {location && (
        <div class="listing-address-row">
          <svg class="listing-address-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          <span>{location}</span>
        </div>
      )}
    </div>
  </section>

  <section class="listing-detail-section pb-12">
    <div class="max-w-7xl mx-auto px-6">
      <div class="listing-detail-grid">
        <div class="listing-detail-main">
          <div class="listing-key-stats">
            <div class="listing-stat-cell">
              <div class="listing-stat-label">Price</div>
              {hasPrice ? (
                <div class="listing-stat-value">{priceLabel}</div>
              ) : (
                <div class="listing-stat-value--medium">{priceLabel}</div>
              )}
            </div>
            {acres && (
              <div class="listing-stat-cell">
                <div class="listing-stat-label">Lot Size</div>
                <div class="listing-stat-value--dark">{acres}</div>
              </div>
            )}
            {sqft && (
              <div class="listing-stat-cell">
                <div class="listing-stat-label">Square Feet</div>
                <div class="listing-stat-value--dark">{sqft}</div>
              </div>
            )}
            <div class="listing-stat-cell">
              <div class="listing-stat-label">Homesite</div>
              <div class="listing-stat-value--dark">Lot {lot.lot_number}</div>
            </div>
            {typeLabel && (
              <div class="listing-stat-cell">
                <div class="listing-stat-label">Lot Type</div>
                <div class="listing-stat-value--medium">{typeLabel}</div>
              </div>
            )}
          </div>

          <div>
            <h2 class="listing-description-heading">About this homesite</h2>
            <div class="listing-description-body">
              {blurb
                ? blurb.split(/\n{2,}/).map((para) => <p>{para}</p>)
                : (
                  <p>
                    {title} is {status.label === 'Available' ? 'an available' : `a ${status.label.toLowerCase()}`} homesite
                    in {n.name}{location ? `, ${location}` : ''}.
                    {acres ? ` The lot spans ${acres}.` : ''}
                    {lot.builder?.name ? ` Homes here are built by ${lot.builder.name}.` : ''}
                  </p>
                )}
              <p>
                Reach out to the Julie Wright Realty Group team for pricing details, available
                floor plans, and to schedule a walk of the site.
              </p>
            </div>
          </div>

          {lot.builder?.name && (
            <div class="mt-8 pt-8 border-t border-earth-200">
              <h2 class="listing-description-heading">Builder</h2>
              <div class="flex items-center gap-4">
                {lot.builder.brand_color && (
                  <span class="w-3 h-3 rounded-full shrink-0" style={`background:${lot.builder.brand_color}`} aria-hidden="true"></span>
                )}
                <div>
                  <p class="font-display text-lg text-earth-900">{lot.builder.name}</p>
                  {lot.builder.website_url && (
                    <a href={lot.builder.website_url} target="_blank" rel="noopener" class="text-sm text-red-600 hover:text-red-700 inline-flex items-center gap-1">
                      Visit builder site
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          )}

          {documents.length > 0 && (
            <div class="listing-documents">
              <h2 class="listing-description-heading">Floor Plans &amp; Documents</h2>
              <ul class="listing-documents-list">
                {documents.map((doc) => (
                  <li>
                    <a
                      href={doc.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-doc-viewer
                      data-doc-id={doc.id}
                      data-doc-title={doc.title}
                      data-doc-mime={doc.mime ?? ''}
                      class="listing-document-link"
                    >
                      <svg class="listing-document-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                      <div class="listing-document-body">
                        <div class="listing-document-row">
                          <span class="listing-document-title">{doc.title}</span>
                          {humanizeType(doc.document_type) && (
                            <span class="listing-document-pill">{humanizeType(doc.document_type)}</span>
                          )}
                        </div>
                      </div>
                      <svg class="listing-document-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <aside class="listing-sidebar">
          <div class="listing-contact-card">
            <h2 class="listing-contact-heading">Interested in {title}?</h2>
            <p class="listing-contact-desc">Ask about pricing, availability, and floor plans for this homesite.</p>
            <dl class="space-y-3 text-sm mb-6">
              <div class="flex justify-between gap-4">
                <dt class="text-earth-500">Status</dt>
                <dd class="text-earth-900 font-semibold">{status.label}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-earth-500">Price</dt>
                <dd class="text-earth-900 font-semibold">{priceLabel}</dd>
              </div>
              {acres && (
                <div class="flex justify-between gap-4">
                  <dt class="text-earth-500">Lot Size</dt>
                  <dd class="text-earth-900 font-semibold">{acres}</dd>
                </div>
              )}
              {lot.builder?.name && (
                <div class="flex justify-between gap-4">
                  <dt class="text-earth-500">Builder</dt>
                  <dd class="text-earth-900 font-semibold text-right">{lot.builder.name}</dd>
                </div>
              )}
            </dl>
            <BtnArrow href="#contact" class="w-full justify-center">Ask about this homesite</BtnArrow>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {siblings.length > 0 && (
    <section class="pb-16">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
          <h2 class="font-display text-2xl text-earth-900">More homesites in {n.name}</h2>
          <a href={`/neighborhoods/${n.slug}#homesites`} class="text-sm text-red-600 hover:text-red-700 font-semibold inline-flex items-center gap-1">
            View all homesites
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {siblings.map((l, i) => (
            <LotCard lot={l} neighborhoodSlug={n.slug} neighborhoodName={n.name} index={i} />
          ))}
        </div>
      </div>
    </section>
  )}

  <DocumentViewerModal />

  <div id="contact" class="scroll-mt-28"></div>
  <MiniContactForm
    neighborhoodId={n.id}
    agents={nbAgents}
    heading={`Ask about ${title}`}
    description={`Interested in this homesite in ${n.name}? Send us a message and our team will follow up with pricing, availability, and floor-plan options.`}
  />
</BaseLayout>
