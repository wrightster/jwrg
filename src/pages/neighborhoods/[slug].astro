---
// SSR: dynamic route with live listings + lots (short-cached by middleware).
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import DocumentViewerModal from '../../components/DocumentViewerModal.astro';
import MiniContactForm from '../../components/MiniContactForm.astro';
import ListingCard from '../../components/ListingCard.astro';
import LotCard from '../../components/LotCard.astro';
import BtnArrow from '../../components/BtnArrow.astro';
import { fetchNeighborhood, fetchListings, fetchNeighborhoodLots, groupDocuments, photoSrc, photoSrcSet, formatPrice } from '../../lib/api';
import { neighborhoodSites } from '../../data/neighborhoodSites';

const { slug } = Astro.params;
const n = slug ? await fetchNeighborhood(slug) : null;

if (!n) {
  return Astro.redirect('/neighborhoods');
}

// Homes published on JWRG that belong to this neighborhood (site-accurate count:
// active/public statuses, jwrg only — may differ from n.listings_count), and the
// subdivision lots for the sidebar quick facts (available-lot count + a
// "from the $X00s" starting price off the cheapest available lot's base_price).
// Both key off the resolved neighborhood slug and are independent of each other,
// so fetch them concurrently rather than in series.
const [nListings, lots] = await Promise.all([
  fetchListings({ neighborhood: n.slug, perPage: 100 }),
  fetchNeighborhoodLots(n.slug),
]);
const listingCount = nListings.length;
const availableLots = lots.filter((l) => l.status === 'available');
const availableLotCount = availableLots.length;
// Lots to show as cards: everything except common-area parcels (roads, open
// space) — a full inventory board, with status pills distinguishing what's
// still for sale. Keeps the office's lot-number sort.
const displayLots = lots.filter((l) => l.status !== 'common_area');
const availableBasePrices = availableLots
  .map((l) => Number(l.base_price))
  .filter((p) => Number.isFinite(p) && p > 0);
const startingPrice = availableBasePrices.length ? Math.min(...availableBasePrices) : null;
// Bucket the starting price the way homes are marketed: "$400s" = $400,000s,
// "$80s" = $80,000s for sub-$100k land, "$1.2M" once past a million.
const priceFromLabel = (p: number): string => {
  if (p >= 1_000_000) return `From $${(Math.floor(p / 100_000) / 10).toFixed(1)}M`;
  if (p >= 100_000) return `From the $${Math.floor(p / 100_000) * 100}s`;
  return `From the $${Math.floor(p / 10_000) * 10}s`;
};
const startingPriceLabel = startingPrice != null ? priceFromLabel(startingPrice) : null;

// A neighborhood with a brand mark (the office-managed featured image) shows
// it as the hero (mirroring the neighborhoods grid) instead of its API photos
// — which for these are themselves logos that would crop badly in the gallery
// tiles. Manage the mark on the office's neighborhood Details tab (or MCP).
//
// Sizing keeps the grid's *relative* sizing: each logo fits (object-contain) into
// a `scale`-fraction of a cap box whose aspect matches the grid card's content
// box (226×153.5), enlarged ~2.18× so Preserve West — the scale=1.0 anchor —
// lands at the size it had before, and every other mark scales with it. But
// rather than center the mark in that (tall) cap box, we size the container to
// the logo's OWN box so it hugs the mark with no empty top/bottom space: width =
// the mark's fitted width, height follows via `aspect-ratio`. See index.astro
// for the grid side.
const logo = n.featured_image
  ? {
      src: n.featured_image.url,
      scale: n.featured_image.scale ?? undefined,
      aspect: n.featured_image.aspect ?? undefined,
    }
  : undefined;
const logoScale = logo?.scale ?? 1;
const logoAspect = logo?.aspect ?? 1;
// Cap box = grid content box (226×153.5) × ~2.18. A wide mark is width-capped,
// a tall/square one height-capped; either way logoW is its fitted width in px.
const CAP_W = 492;
const CAP_H = 334;
const logoW = Math.round((logoAspect < CAP_W / CAP_H ? CAP_H * logoAspect : CAP_W) * logoScale);

// If this neighborhood has its own JWRG-built microsite, link to it from the
// top of the sidebar. See src/data/neighborhoodSites.ts.
const neighborhoodSite = neighborhoodSites[n.slug];

const photos = n.photos ?? (n.primary_photo ? [n.primary_photo] : []);
const totalImages = photos.length;
// Without a brand mark, the photo grid doubles as the page hero. With one,
// photos render instead as a compact inline carousel beside the documents
// (cycle through marketing maps, streetscapes, site plans there) — the mark
// keeps the hero to itself.
const showHeroGallery = !logo && totalImages > 0;
const showInlineGallery = Boolean(logo) && totalImages > 0;
const igCaptions = photos.map((p) => p.caption ?? '');
const heroSrcs = photos.slice(0, 5).map((p, i) => photoSrc(p, i === 0 ? 1600 : 800));
// Alpha-preserving webp so transparent logos used as neighborhood images sit on
// the light tile background instead of the jpg's black matte.
const heroWebpSets = photos.slice(0, 5).map((p) => photoSrcSet(p, 'webp'));
const lightboxSrcs = photos.map((p) => photoSrc(p, 1600));

const hoaLine = (() => {
  if (!n.hoa.fee && !n.hoa.frequency) return null;
  const fee = n.hoa.fee ? formatPrice(String(n.hoa.fee)) : null;
  const freq = n.hoa.frequency;
  if (fee && freq) return `${fee} / ${freq}`;
  return fee ?? null;
})();

// Public documents grouped by their office-managed folder (display group):
// groups ordered by folder sort_order, folderless docs in a trailing
// "Documents" bucket. Only docs with a resolvable URL render.
const documentGroups = groupDocuments((n.documents ?? []).filter((d) => d.url));
// When everything is folderless there's just the default bucket — skip its
// redundant "Documents" subheading under the section title.
const onlyDefaultGroup = documentGroups.length === 1 && documentGroups[0].id === 'ungrouped';

const location = [n.city, n.county && `${n.county} County`].filter(Boolean).join(' · ');
// marketing_description is rich HTML (office RichEditor); description is legacy plain text.
const aboutHtml = n.marketing_description?.trim() || null;
const aboutText = n.description?.trim() || null;
const aboutStripped = (aboutHtml ?? aboutText ?? '')
  .replace(/<[^>]*>/g, ' ')
  .replace(/&nbsp;/gi, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const hasAbout = aboutStripped.length > 0;
// Meta description must be plain text — never raw HTML tags.
const metaDescription = aboutStripped || `Explore ${n.name}, a Triangle-area community offered by Julie Wright Realty Group.`;
---

<BaseLayout
  title={`${n.name} | Julie Wright Realty Group`}
  description={metaDescription}
>
  <section class="pt-8 pb-8">
    <div class="max-w-7xl mx-auto px-6">
      <a href="/neighborhoods" class="text-sm text-red-600 hover:text-red-700 inline-flex items-center gap-1 mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back to neighborhoods
      </a>

      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          {/* The logo is a wordmark carrying the name, so hide the plain-text
              title on logo pages — but keep an sr-only h1 for SEO/a11y. */}
          {logo ? (
            <h1 class="sr-only">{n.name}</h1>
          ) : (
            <h1 class="font-display text-4xl md:text-5xl text-earth-900 leading-tight">
              {n.name}
            </h1>
          )}
        </div>
      </div>
    </div>
  </section>

  {logo && (
    <section class="pb-12">
      <div class="max-w-7xl mx-auto px-6">
        <div
          class="mx-auto flex items-center justify-center"
          style={`width:${logoW}px;max-width:90vw;aspect-ratio:${logoAspect};`}
        >
          <img
            src={logo.src}
            alt={n.name}
            class="w-full h-full object-contain"
          />
        </div>
      </div>
    </section>
  )}

  {showHeroGallery && (
    <section class="pb-12">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          {heroSrcs.slice(0, 1).map((src, i) => (
            <button
              type="button"
              class="gallery-tile md:col-span-2 md:row-span-2 aspect-[4/3] md:aspect-auto rounded-sm overflow-hidden relative group bg-gradient-to-br from-earth-200 via-gold-100 to-earth-100"
              data-lb-index={i}
              aria-label={`View photo ${i + 1} of ${totalImages}`}
            >
              <picture class="contents">
                {heroWebpSets[i] && <source type="image/webp" srcset={heroWebpSets[i]} sizes="(min-width:768px) 66vw, 100vw" />}
                <img src={src ?? undefined} alt={photos[i].alt ?? photos[i].caption ?? n.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" />
              </picture>
            </button>
          ))}
          {heroSrcs.slice(1, 5).map((src, i) => (
            <button
              type="button"
              class="gallery-tile aspect-[4/3] rounded-sm overflow-hidden relative group bg-gradient-to-br from-earth-200 via-gold-100 to-earth-100"
              data-lb-index={i + 1}
              aria-label={`View photo ${i + 2} of ${totalImages}`}
            >
              <picture class="contents">
                {heroWebpSets[i + 1] && <source type="image/webp" srcset={heroWebpSets[i + 1]} sizes="(min-width:768px) 22vw, 50vw" />}
                <img src={src ?? undefined} alt={photos[i + 1].alt ?? photos[i + 1].caption ?? n.name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" />
              </picture>
              {i === 3 && totalImages > 5 && (
                <div class="absolute inset-0 bg-earth-950/60 flex flex-col items-center justify-center text-earth-50">
                  <svg class="w-8 h-8 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.41a2.25 2.25 0 013.182 0l2.909 2.91M3.75 21h16.5a2.25 2.25 0 002.25-2.25V5.25a2.25 2.25 0 00-2.25-2.25H3.75a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 003.75 21z"/></svg>
                  <span class="font-semibold">+ {totalImages - 5} more</span>
                </div>
              )}
            </button>
          ))}
        </div>
        {totalImages > 1 && (
          <div class="flex justify-center mt-6">
            <button
              type="button"
              id="view-all-photos"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-sm border-2 border-earth-900 text-earth-900 hover:bg-earth-900 hover:text-earth-50 font-semibold transition-all text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.41a2.25 2.25 0 013.182 0l2.909 2.91M3.75 21h16.5a2.25 2.25 0 002.25-2.25V5.25a2.25 2.25 0 00-2.25-2.25H3.75a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 003.75 21z"/></svg>
              View all {totalImages} photos
            </button>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="py-12">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 space-y-10">
        {hasAbout && (
          <div>
            <h2 class="font-display text-2xl text-earth-900 mb-4">About {n.name}</h2>
            {aboutHtml ? (
              <div class="prose max-w-none text-earth-700 leading-relaxed" set:html={aboutHtml} />
            ) : (
              <div class="prose max-w-none text-earth-700 leading-relaxed whitespace-pre-line">{aboutText}</div>
            )}
          </div>
        )}

        {n.amenities.length > 0 && (
          <div>
            <h2 class="font-display text-2xl text-earth-900 mb-4">Community Amenities</h2>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-earth-700">
              {n.amenities.map((a) => (
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-gold-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {(n.school_district || n.utilities.length > 0) && (
          <div class="grid sm:grid-cols-2 gap-6">
            {n.school_district && (
              <div>
                <h3 class="font-display text-lg text-earth-900 mb-2">Schools</h3>
                <p class="text-earth-700 text-sm">{n.school_district}</p>
              </div>
            )}
            {n.utilities.length > 0 && (
              <div>
                <h3 class="font-display text-lg text-earth-900 mb-2">Utilities</h3>
                <ul class="text-earth-700 text-sm space-y-1">
                  {n.utilities.map((u) => <li>{u}</li>)}
                </ul>
              </div>
            )}
          </div>
        )}

        {n.deed_restrictions_summary && (
          <div>
            <h2 class="font-display text-2xl text-earth-900 mb-2">Deed Restrictions</h2>
            <p class="text-earth-700 leading-relaxed text-sm">{n.deed_restrictions_summary}</p>
          </div>
        )}

        {(documentGroups.length > 0 || showInlineGallery) && (
          <div>
            <h2 class="font-display text-2xl text-earth-900 mb-4">
              {documentGroups.length > 0 ? 'Documents & Resources' : 'Photos'}
            </h2>
            <div class={documentGroups.length > 0 && showInlineGallery ? 'grid md:grid-cols-2 gap-8 items-start' : ''}>
              {documentGroups.length > 0 && (
                <div class="space-y-6">
                  {documentGroups.map((group) => (
                    <div>
                      {!onlyDefaultGroup && (
                        <h3 class="font-display text-lg text-earth-900 mb-2">{group.name}</h3>
                      )}
                      <ul class="space-y-1.5">
                        {group.documents.map((doc) => (
                          <li>
                            <a
                              href={doc.url}
                              target="_blank"
                              rel="noopener"
                              data-doc-viewer
                              data-doc-id={doc.id}
                              data-doc-title={doc.title}
                              data-doc-mime={doc.mime ?? ''}
                              class="inline-flex items-start gap-2 text-red-600 hover:text-red-700 text-sm"
                            >
                              <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                              <span>{doc.title}</span>
                            </a>
                            {doc.description && (
                              <p class="text-earth-500 text-xs ml-6 mt-0.5">{doc.description}</p>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              )}
              {showInlineGallery && (
                <div id="inline-gallery" class="md:sticky md:top-28">
                  <div class="relative aspect-[4/3] rounded-sm overflow-hidden bg-earth-100/60 border border-earth-200/60">
                    {photos.map((p, i) => (
                      <button
                        type="button"
                        class={`ig-slide absolute inset-0 w-full h-full cursor-pointer ${i === 0 ? '' : 'hidden'}`}
                        data-lb-index={i}
                        aria-label={`View photo ${i + 1} of ${totalImages} full screen`}
                      >
                        <picture class="contents">
                          {photoSrcSet(p, 'webp') && (
                            <source type="image/webp" srcset={photoSrcSet(p, 'webp')} sizes="(min-width:768px) 33vw, 100vw" />
                          )}
                          <img
                            src={photoSrc(p, 800) ?? undefined}
                            alt={p.alt ?? p.caption ?? n.name}
                            class="w-full h-full object-contain"
                            loading="lazy"
                          />
                        </picture>
                      </button>
                    ))}
                    {totalImages > 1 && (
                      <>
                        <button type="button" id="ig-prev" aria-label="Previous photo" class="absolute left-2 top-1/2 -translate-y-1/2 z-10 w-9 h-9 rounded-full bg-earth-50/95 text-earth-900 hover:bg-red-600 hover:text-earth-50 flex items-center justify-center shadow transition-colors">
                          <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                        </button>
                        <button type="button" id="ig-next" aria-label="Next photo" class="absolute right-2 top-1/2 -translate-y-1/2 z-10 w-9 h-9 rounded-full bg-earth-50/95 text-earth-900 hover:bg-red-600 hover:text-earth-50 flex items-center justify-center shadow transition-colors">
                          <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        </button>
                      </>
                    )}
                  </div>
                  <div class="flex items-center justify-between gap-4 mt-2 text-xs text-earth-500">
                    <span id="ig-caption">{igCaptions[0]}</span>
                    {totalImages > 1 && <span id="ig-counter" class="tabular-nums shrink-0">1 / {totalImages}</span>}
                  </div>
                </div>
              )}
            </div>
          </div>
        )}
      </div>

      <aside class="space-y-6">
        {neighborhoodSite && (
          <BtnArrow href={neighborhoodSite} target="_blank" rel="noopener" class="w-full justify-center">
            Full Neighborhood Site
          </BtnArrow>
        )}

        <div class="bg-earth-100/60 rounded-sm p-6 border border-earth-200/60">
          <dl class="space-y-3 text-sm">
            {location && (
              <div>
                <dt class="text-earth-500 text-xs uppercase tracking-wider">Location</dt>
                <dd class="text-earth-900 mt-0.5">{location}</dd>
              </div>
            )}
            {n.total_lots && (
              <div>
                <dt class="text-earth-500 text-xs uppercase tracking-wider">Total Lots</dt>
                <dd class="text-earth-900 mt-0.5">{n.total_lots}</dd>
              </div>
            )}
            {n.total_phases && (
              <div>
                <dt class="text-earth-500 text-xs uppercase tracking-wider">Phases</dt>
                <dd class="text-earth-900 mt-0.5">{n.total_phases}</dd>
              </div>
            )}
            {n.hoa.name && (
              <div>
                <dt class="text-earth-500 text-xs uppercase tracking-wider">HOA</dt>
                <dd class="text-earth-900 mt-0.5">{n.hoa.name}</dd>
              </div>
            )}
            {hoaLine && (
              <div>
                <dt class="text-earth-500 text-xs uppercase tracking-wider">HOA Fee</dt>
                <dd class="text-earth-900 mt-0.5">{hoaLine}</dd>
              </div>
            )}
            {availableLotCount > 0 && (
              <div>
                <dt class="text-earth-500 text-xs uppercase tracking-wider">Available Lots</dt>
                <dd class="text-earth-900 mt-0.5">
                  {displayLots.length > 0 ? (
                    <a href="#homesites" class="text-red-600 hover:text-red-700">{availableLotCount}</a>
                  ) : (
                    availableLotCount
                  )}
                </dd>
              </div>
            )}
            {startingPriceLabel && (
              <div>
                <dt class="text-earth-500 text-xs uppercase tracking-wider">Price Range</dt>
                <dd class="text-earth-900 mt-0.5">{startingPriceLabel}</dd>
              </div>
            )}
            {listingCount > 0 && (
              <div>
                <dt class="text-earth-500 text-xs uppercase tracking-wider">Available Listings</dt>
                <dd class="text-earth-900 mt-0.5">
                  <a href="#homes" class="text-red-600 hover:text-red-700">{listingCount}</a>
                </dd>
              </div>
            )}
          </dl>
        </div>

      </aside>
    </div>
  </section>

  {displayLots.length > 0 && (
    <section id="homesites" class="pb-16 scroll-mt-28">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
          <div>
            <h2 class="font-display text-3xl text-earth-900">Homesites in {n.name}</h2>
          </div>
          {availableLotCount > 0 && (
            <p class="text-sm text-earth-500">
              <span class="font-semibold text-earth-800">{availableLotCount}</span> available
            </p>
          )}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {displayLots.map((lot, i) => (
            <LotCard lot={lot} neighborhoodSlug={n.slug} neighborhoodName={n.name} index={i} />
          ))}
        </div>
      </div>
    </section>
  )}

  {listingCount > 0 && (
    <section id="homes" class="pb-16 scroll-mt-28">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
          <div>
            <h2 class="font-display text-3xl text-earth-900">Homes in {n.name}</h2>
          </div>
          <a
            href={`/listings?neighborhood=${n.slug}`}
            class="text-sm text-red-600 hover:text-red-700 font-semibold inline-flex items-center gap-1"
          >
            View in all listings
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {nListings.map((listing, i) => <ListingCard listing={listing} index={i} />)}
        </div>
      </div>
    </section>
  )}

  <MiniContactForm neighborhoodId={n.id} />

  {documentGroups.length > 0 && <DocumentViewerModal />}

  {(showHeroGallery || showInlineGallery) && (
    <div
      id="lightbox"
      class="lightbox"
      role="dialog"
      aria-modal="true"
      aria-label={`${n.name} photo gallery`}
    >
      <img id="lb-bg" src="" alt="" aria-hidden="true" class="lightbox-bg" />
      <div class="lightbox-overlay"></div>

      <button id="lb-close" class="lightbox-close" aria-label="Close gallery">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>

      {totalImages > 1 && (
        <>
          <button id="lb-prev" class="lightbox-prev" aria-label="Previous image">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="w-10 h-10 pointer-events-none"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <button id="lb-next" class="lightbox-next" aria-label="Next image">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="w-10 h-10 pointer-events-none"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </button>
        </>
      )}

      <div class="lightbox-body">
        <img id="lb-image" src="" alt="" class="lightbox-img" />
      </div>

      <div class="lightbox-counter" id="lb-counter"></div>
    </div>
  )}

  <style>
    .gallery-tile { cursor: pointer; }
    .gallery-tile:focus-visible { outline: 2px solid var(--color-red-600); outline-offset: 4px; }

    .lightbox {
      position: fixed; inset: 0; z-index: 100;
      display: flex; align-items: center; justify-content: center;
      padding-top: 5rem;
      backdrop-filter: blur(12px);
      opacity: 0; pointer-events: none;
      transition: opacity 300ms ease;
    }
    .lightbox.is-open { opacity: 1; pointer-events: auto; }
    .lightbox-bg {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; opacity: 0.45; filter: blur(28px);
      z-index: 0; transition: opacity 200ms ease;
    }
    .lightbox-overlay {
      position: absolute; inset: 0;
      background-color: oklch(from var(--color-earth-950) l c h / 0.6);
      z-index: 1;
    }
    .lightbox::after {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(ellipse at center, transparent 40%, oklch(from var(--color-earth-950) l c h / 0.85) 100%);
      z-index: 2;
    }
    .lightbox-close {
      position: absolute; top: 1rem; right: 1rem; z-index: 10;
      width: 3rem; height: 3rem;
      display: flex; align-items: center; justify-content: center;
      color: oklch(from var(--color-earth-50) l c h / 0.7);
      transition: color 200ms ease;
    }
    .lightbox-close:hover { color: var(--color-earth-50); }
    .lightbox-prev, .lightbox-next {
      position: absolute; top: 50%; transform: translateY(-50%); z-index: 20;
      width: 4rem; height: 4rem;
      display: flex; align-items: center; justify-content: center;
      background-color: oklch(from var(--color-earth-50) l c h / 0.95);
      color: var(--color-earth-900);
      border-radius: 9999px;
      transition: all 200ms ease;
      cursor: pointer; opacity: 0.6;
    }
    .lightbox-prev:hover, .lightbox-next:hover {
      background-color: var(--color-red-600);
      color: var(--color-earth-50);
      opacity: 1;
    }
    .lightbox-prev { left: 1.5rem; }
    .lightbox-next { right: 1.5rem; }
    .lightbox-body {
      position: relative; z-index: 10;
      max-width: 80rem; max-height: 85vh;
      margin: 0 auto;
      padding: 0 6rem;
    }
    .lightbox-img {
      max-width: 100%; max-height: 85vh;
      object-fit: contain; margin: 0 auto;
      transition: opacity 250ms ease;
    }
    .lightbox-counter {
      position: absolute; bottom: 1.5rem; left: 50%; transform: translateX(-50%);
      z-index: 10;
      color: oklch(from var(--color-earth-50) l c h / 0.7);
      font-size: 0.875rem;
      font-variant-numeric: tabular-nums;
    }
    @media (max-width: 767px) {
      .lightbox-body { padding-left: 1rem; padding-right: 1rem; padding-bottom: 8rem; }
      .lightbox-prev, .lightbox-next { width: 3rem; height: 3rem; top: auto; bottom: 2rem; }
      .lightbox-prev { left: 50%; transform: translateX(-4.5rem); }
      .lightbox-next { left: 50%; right: auto; transform: translateX(1.5rem); }
      .lightbox-counter { bottom: 5.5rem; }
    }
  </style>

  {(showHeroGallery || showInlineGallery) && (
    <script define:vars={{ lightboxSrcs, totalImages, igCaptions }}>
      let currentIndex = 0;
      let trigger = null;

      const lightbox = document.getElementById('lightbox');
      // Closed lightbox is only opacity:0/pointer-events:none — mark it inert so
      // its Close/Prev/Next buttons leave the tab order until it's opened.
      if (lightbox) lightbox.inert = true;
      const lbImage = document.getElementById('lb-image');
      const lbBg = document.getElementById('lb-bg');
      const lbCounter = document.getElementById('lb-counter');
      const lbClose = document.getElementById('lb-close');
      const lbPrev = document.getElementById('lb-prev');
      const lbNext = document.getElementById('lb-next');

      function setLightboxImage(i) {
        currentIndex = i;
        const src = lightboxSrcs[i];
        if (lbImage) {
          lbImage.style.opacity = '0';
          setTimeout(() => {
            lbImage.src = src;
            lbImage.alt = `Photo ${i + 1} of ${totalImages}`;
            lbImage.style.opacity = '1';
          }, 120);
        }
        if (lbBg) {
          lbBg.style.opacity = '0';
          setTimeout(() => {
            lbBg.src = src;
            lbBg.style.opacity = '0.45';
          }, 120);
        }
        if (lbCounter) lbCounter.textContent = `${i + 1} / ${totalImages}`;
      }

      function openLightbox(index, source) {
        trigger = source ?? null;
        setLightboxImage(index);
        if (lightbox) lightbox.inert = false;
        lightbox?.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        lbClose?.focus();
      }

      function closeLightbox() {
        lightbox?.classList.remove('is-open');
        if (lightbox) lightbox.inert = true;
        document.body.style.overflow = '';
        trigger?.focus();
        trigger = null;
      }

      function next() { setLightboxImage((currentIndex + 1) % totalImages); }
      function prev() { setLightboxImage((currentIndex - 1 + totalImages) % totalImages); }

      document.querySelectorAll('.gallery-tile').forEach((tile) => {
        tile.addEventListener('click', () => {
          const idx = parseInt(tile.getAttribute('data-lb-index') ?? '0', 10);
          openLightbox(idx, tile);
        });
      });

      const viewAll = document.getElementById('view-all-photos');
      if (viewAll) {
        viewAll.addEventListener('click', () => openLightbox(0, viewAll));
      }

      lbClose?.addEventListener('click', closeLightbox);
      lbPrev?.addEventListener('click', prev);
      lbNext?.addEventListener('click', next);

      lightbox?.addEventListener('click', (e) => {
        if (!e.target.closest('button, .lightbox-body, .lightbox-counter')) {
          closeLightbox();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (!lightbox?.classList.contains('is-open')) return;
        if (e.key === 'Escape') { closeLightbox(); return; }
        if (e.key === 'ArrowRight') { next(); return; }
        if (e.key === 'ArrowLeft') { prev(); return; }
        if (e.key === 'Tab') {
          e.preventDefault();
          const focusable = [lbClose, lbPrev, lbNext].filter(Boolean);
          const idx = focusable.indexOf(document.activeElement);
          const nextIdx = e.shiftKey
            ? (idx - 1 + focusable.length) % focusable.length
            : (idx + 1) % focusable.length;
          focusable[nextIdx].focus();
        }
      });

      let swipeStartX = 0;
      let swipeStartY = 0;
      lightbox?.addEventListener('touchstart', (e) => {
        swipeStartX = e.touches[0].clientX;
        swipeStartY = e.touches[0].clientY;
      }, { passive: true });
      lightbox?.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - swipeStartX;
        const dy = e.changedTouches[0].clientY - swipeStartY;
        if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) {
          if (dx < 0) next(); else prev();
        }
      }, { passive: true });

      // Inline carousel (beside the documents): cycle slides in place; a
      // click on the visible slide opens the shared lightbox at that photo.
      const igSlides = Array.from(document.querySelectorAll('.ig-slide'));
      if (igSlides.length > 0) {
        const igCaption = document.getElementById('ig-caption');
        const igCounter = document.getElementById('ig-counter');
        let igIndex = 0;

        function showSlide(i) {
          igIndex = (i + igSlides.length) % igSlides.length;
          igSlides.forEach((slide, j) => slide.classList.toggle('hidden', j !== igIndex));
          if (igCaption) igCaption.textContent = igCaptions[igIndex] ?? '';
          if (igCounter) igCounter.textContent = `${igIndex + 1} / ${igSlides.length}`;
        }

        document.getElementById('ig-prev')?.addEventListener('click', () => showSlide(igIndex - 1));
        document.getElementById('ig-next')?.addEventListener('click', () => showSlide(igIndex + 1));

        igSlides.forEach((slide) => {
          slide.addEventListener('click', () => {
            openLightbox(parseInt(slide.getAttribute('data-lb-index') ?? '0', 10), slide);
          });
        });
      }
    </script>
  )}
</BaseLayout>
