---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageBanner from '../../../components/PageBanner.astro';
import ResourceNav from '../../../components/ResourceNav.astro';
import MiniContactForm from '../../../components/MiniContactForm.astro';

export const prerender = true;

const resources = [
  {
    title: 'Free Relocation Package',
    description: 'Triangle area information put together around your move and sent to your door, at no cost.',
    href: '/resources/relocation/relocation-package',
  },
  {
    title: 'Moving Tips',
    description: 'Eight weeks out to moving day: what to sort, what to sell, and how to make it easier on the kids and the dog.',
    href: '/resources/relocation/moving-tips',
  },
  {
    title: 'About the Triangle Area',
    description: 'The counties and towns we serve, and what living in each of them is like.',
    href: '/about#triangle-area',
  },
];
---

<BaseLayout title="Relocation Resources | Julie Wright Realty Group">
  <PageBanner
    label="Relocating to the Triangle"
    title="Relocating Resources"
    description="Coming from across the country, or from two counties over. We'll help you work out where to land, and handle the rest from there."
  />

  <ResourceNav href="/resources" label="Resources" glossary />

  <section class="pt-4 pb-16 lg:pt-5 lg:pb-20">
    <div class="content-wrap">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="section-heading">Getting Oriented</h2>
        <p class="text-earth-600 leading-relaxed mt-4">
          The hard part of moving here isn't the boxes. It's choosing where to live before you know the place: which school district, how long a commute you can actually stand, whether you want sidewalks or a few acres. Tell us your timeline and what you're weighing, and we'll send you the information that bears on it.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {resources.map((r) => (
          <a
            href={r.href}
            class="group flex flex-col bg-white rounded-sm p-8 ring-1 ring-inset ring-earth-100 hover:ring-2 hover:ring-red-600 transition-all duration-300"
          >
            <h3 class="font-display text-xl text-earth-900 group-hover:text-red-600 transition-colors">
              {r.title}
            </h3>
            <p class="text-earth-600 mt-3 mb-6 leading-relaxed">{r.description}</p>
            <span class="mt-auto pt-4 border-t border-earth-100 text-red-600 text-sm font-display flex items-center gap-1">
              Learn More
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <MiniContactForm
    heading="Have a relocation question?"
    description="Tell us your timeline and where you're coming from, and we'll come back with something specific."
  />
</BaseLayout>
