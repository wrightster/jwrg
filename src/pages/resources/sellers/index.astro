---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageBanner from '../../../components/PageBanner.astro';
import ResourceNav from '../../../components/ResourceNav.astro';
import MiniContactForm from '../../../components/MiniContactForm.astro';

export const prerender = true;

const resources = [
  {
    title: 'Staging Tips',
    description: 'What to fix, clean, and pack away before the photographer arrives. Most of it costs a weekend, not a contractor.',
    href: '/resources/sellers/staging-tips',
  },
  {
    title: 'Home Value Estimate',
    description: 'A comparative market analysis of your property, done by someone who sells in your neighborhood. No obligation.',
    href: '/resources/sellers/home-value',
  },
  {
    title: 'List Your Property',
    description: 'Ready to list? Tell us about the house and we\'ll set up a consultation in person.',
    href: '/resources/sellers/list-your-property',
  },
  {
    title: 'Neighborhood Sold Report',
    description: 'What comparable homes near you have actually sold for, not what they were listed at.',
    href: '/resources/sellers/neighborhood-sold-report',
  },
];
---

<BaseLayout title="Seller Resources | Julie Wright Realty Group">
  <PageBanner
    label="For Sellers"
    title="Seller Resources"
    description="Two questions matter: what the house is worth, and what it will take to get that. Both have real answers, and they come from the comps and the condition of the property."
  />

  <ResourceNav href="/resources" label="Resources" glossary />

  <section class="pt-4 pb-16 lg:pt-5 lg:pb-20">
    <div class="content-wrap">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10 items-start mb-16">
        <div>
          <h2 class="font-display text-3xl text-earth-900 mb-4">Where sellers lose money</h2>
          <p class="text-earth-700 leading-relaxed">
            Price a house too high and it sits, and a house that has sat draws offers below what it would have brought in its first week. Price it too low and you have simply handed the difference to the buyer. Timing, condition, and how the negotiation gets handled each move the final number too, which is several places in one sale for a few thousand dollars to quietly change hands.
          </p>
        </div>
        <div>
          <h2 class="font-display text-3xl text-earth-900 mb-4">What we do about it</h2>
          <p class="text-earth-700 leading-relaxed">
            We have been selling in the Triangle since the 1970s, which in practice means we know what your house will fetch and where a buyer's agent will push. You get a price built from comparable sales, a marketing plan for this property rather than a template, and someone who explains each decision to you before it gets made.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {resources.map((r) => (
          <a
            href={r.href}
            class="group flex flex-col bg-white rounded-sm p-8 ring-1 ring-inset ring-earth-100 hover:ring-2 hover:ring-red-600 transition-all duration-300"
          >
            <h3 class="font-display text-xl text-earth-900 group-hover:text-red-600 transition-colors">
              {r.title}
            </h3>
            <p class="text-earth-600 mt-3 mb-6 leading-relaxed">{r.description}</p>
            <span class="mt-auto pt-4 border-t border-earth-100 text-red-600 text-sm font-display flex items-center gap-1">
              Learn More
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <MiniContactForm />
</BaseLayout>
