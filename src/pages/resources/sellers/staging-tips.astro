---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageBanner from '../../../components/PageBanner.astro';
import ResourceNav from '../../../components/ResourceNav.astro';
import MiniContactForm from '../../../components/MiniContactForm.astro';
import { stagingSections } from '../../../data/stagingTips';

export const prerender = true;
---

<BaseLayout title="Staging Tips | Julie Wright Realty Group">
  <PageBanner
    label="For Sellers"
    title="Staging Tips to Sell Your Home Faster"
    description="Most of this you can do yourself in a weekend, and all of it costs less than the first price cut."
  />

  <ResourceNav href="/resources/sellers" label="For Sellers" glossary />

  <section class="pt-4 pb-16">
    <div class="max-w-3xl mx-auto px-6 space-y-12">
      {stagingSections.map((s) => (
        <div>
          <h2 class="font-display text-2xl md:text-3xl text-earth-900 mb-4 pb-3 border-b border-earth-200">
            {s.heading}
          </h2>
          <div class="space-y-4 text-earth-700 leading-relaxed">
            {s.body.map((p) => <p>{p}</p>)}
          </div>
        </div>
      ))}

      <div class="bg-earth-100 rounded-sm p-8 text-center">
        <h3 class="font-display text-xl text-earth-900 mb-2">Request a Free Home Evaluation</h3>
        <p class="text-earth-600 mb-6">We'll walk the house with you and tell you which repairs are worth making before you list, and which ones buyers won't pay you back for.</p>
        <a href="/resources/sellers/home-value" class="inline-block px-8 py-3.5 bg-red-600 hover:bg-red-700 text-earth-50 font-semibold rounded-sm transition-all">
          Request Evaluation
        </a>
      </div>
    </div>
  </section>

  <MiniContactForm />
</BaseLayout>
