---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageBanner from '../../../components/PageBanner.astro';
import ResourceNav from '../../../components/ResourceNav.astro';
import EmbedForm from '../../../components/EmbedForm.astro';
import MiniContactForm from '../../../components/MiniContactForm.astro';
import { site } from '../../../data/site';

export const prerender = true;

const formToken = site.formTokens.cma;
---

<BaseLayout title="Learn the Value of Your Home | Julie Wright Realty Group">
  <PageBanner
    label="For Sellers"
    title="What's Your Property Worth?"
    description="A valuation from someone who sells in your neighborhood, built from comparable sales and what buyers are doing this month. Free, with no obligation to list."
  />

  <ResourceNav href="/resources/sellers" label="For Sellers" glossary />

  <section class="pt-4 pb-16">
    <div class="max-w-3xl mx-auto px-6">
      <div class="bg-white rounded-sm p-8 md:p-10">
        <h2 class="contact-form-heading">Request a Free Valuation</h2>
        <p class="text-earth-600 mb-6">Tell us about the property and we'll come back to you within one business day. Automated estimates work off public records, so they don't know that you redid the kitchen or that the house backs onto a greenway. We look at the property itself.</p>
        {formToken ? (
          <EmbedForm id="jwrg-cma-form" token={formToken} />
        ) : (
          <p class="text-earth-600 leading-relaxed">
            Our online valuation request form is being configured. In the meantime, please reach us
            by <a href={`tel:${site.phoneRaw}`} class="text-red-600 hover:underline">phone</a>
            or <a href={`mailto:${site.email}`} class="text-red-600 hover:underline">email</a>.
          </p>
        )}
      </div>
    </div>
  </section>

  <MiniContactForm />
</BaseLayout>
