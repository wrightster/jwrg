---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageBanner from '../../../components/PageBanner.astro';
import ResourceNav from '../../../components/ResourceNav.astro';
import MiniContactForm from '../../../components/MiniContactForm.astro';

export const prerender = true;
---

<BaseLayout title="Mortgage Calculator | Julie Wright Realty Group">
  <PageBanner
    label="For Buyers"
    title="Mortgage Calculator"
    description="Estimate a monthly payment: principal, interest, taxes, and insurance. Adjust the numbers to see what moves them."
  />

  <ResourceNav href="/resources/buyers" label="For Buyers" glossary />

  <section class="pt-4 pb-16">
    <div class="max-w-4xl mx-auto px-6">
      <div class="bg-white rounded-sm ring-1 ring-inset ring-earth-100 p-8 md:p-10">
        <form id="mortgage-form" class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label class="form-label" for="loanAmount">Loan Amount ($)</label>
            <input id="loanAmount" type="number" min="0" step="1000" value="350000" class="form-input" />
          </div>
          <div>
            <label class="form-label" for="years">Loan Term (years)</label>
            <input id="years" type="number" min="1" max="40" value="30" class="form-input" />
          </div>
          <div>
            <label class="form-label" for="rate">Interest Rate (%)</label>
            <input id="rate" type="number" min="0" max="20" step="0.01" value="6.5" class="form-input" />
          </div>
          <div>
            <label class="form-label" for="annualTax">Annual Property Tax ($)</label>
            <input id="annualTax" type="number" min="0" step="100" value="3600" class="form-input" />
          </div>
          <div class="md:col-span-2">
            <label class="form-label" for="annualInsurance">Annual Insurance ($)</label>
            <input id="annualInsurance" type="number" min="0" step="100" value="1500" class="form-input" />
          </div>
        </form>

        <div class="mt-10 p-8 bg-earth-100 rounded-sm" role="status" aria-live="polite" aria-atomic="true">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div>
              <div class="text-earth-600 text-xs tracking-widest uppercase">P&I</div>
              <div id="out-pi" class="text-2xl font-display text-earth-900 mt-1">—</div>
            </div>
            <div>
              <div class="text-earth-600 text-xs tracking-widest uppercase">Tax</div>
              <div id="out-tax" class="text-2xl font-display text-earth-900 mt-1">—</div>
            </div>
            <div>
              <div class="text-earth-600 text-xs tracking-widest uppercase">Insurance</div>
              <div id="out-ins" class="text-2xl font-display text-earth-900 mt-1">—</div>
            </div>
            <div>
              <div class="text-red-600 text-xs tracking-widest uppercase">Total / Month</div>
              <div id="out-total" class="text-2xl font-display text-red-600 mt-1">—</div>
            </div>
          </div>
        </div>

        <p class="text-earth-500 text-xs leading-relaxed mt-6">
          An estimate, not a quote. This figure leaves out PMI (usually charged when you put down less than 20%) and any HOA dues, both of which can add meaningfully to what you pay each month. Your real terms depend on your lender, your credit, and your down payment, so get a quote from a licensed lender before you rely on a number.
        </p>
      </div>
    </div>
  </section>

  <MiniContactForm
    heading="Ready to talk to a lender?"
    description="We work with local lenders we'd send our own family to. Ask and we'll make an introduction."
  />
</BaseLayout>

<script>
  function fmt(n: number): string {
    if (!Number.isFinite(n)) return '—';
    return '$' + Math.round(n).toLocaleString('en-US');
  }

  function calc() {
    const loan = parseFloat((document.getElementById('loanAmount') as HTMLInputElement).value) || 0;
    const years = parseFloat((document.getElementById('years') as HTMLInputElement).value) || 0;
    const rate = parseFloat((document.getElementById('rate') as HTMLInputElement).value) || 0;
    const tax = parseFloat((document.getElementById('annualTax') as HTMLInputElement).value) || 0;
    const ins = parseFloat((document.getElementById('annualInsurance') as HTMLInputElement).value) || 0;

    const r = rate / 100 / 12;
    const n = years * 12;
    const pi = r === 0 ? loan / n : (loan * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
    const taxMonthly = tax / 12;
    const insMonthly = ins / 12;

    document.getElementById('out-pi')!.textContent = fmt(pi);
    document.getElementById('out-tax')!.textContent = fmt(taxMonthly);
    document.getElementById('out-ins')!.textContent = fmt(insMonthly);
    document.getElementById('out-total')!.textContent = fmt(pi + taxMonthly + insMonthly);
  }

  document.getElementById('mortgage-form')?.addEventListener('input', calc);
  calc();
</script>
