---
// SSR: the featured strip reflects live listings (short-cached by middleware).
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ListingCard from '../components/ListingCard.astro';
import BtnArrow from '../components/BtnArrow.astro';
import { fetchListings, type ApiListing } from '../lib/api';

let apiError = false;
let featuredListings: ApiListing[] = [];
try {
  featuredListings = await fetchListings({ featured: true, perPage: 6 });
  if (featuredListings.length === 0) {
    featuredListings = (await fetchListings({ perPage: 6 }));
  }
} catch {
  apiError = true;
}

// Photos are CC0 (StockSnap) — free for commercial use, no attribution required.
const helpLinks = [
  { href: '/resources/buyers', label: 'Buying a Home', desc: 'Guides, financing, and a search built around how you live.',
    img: '/images/home/buying.webp', alt: 'House keys hanging from the lock of an open front door' },
  { href: '/resources/sellers', label: 'Selling a Home', desc: 'Pricing strategy, staging, and full-service marketing.',
    img: '/images/home/selling.webp', alt: 'Two-story home with lit windows at dusk' },
  { href: '/resources/relocation', label: 'Relocating', desc: 'Moving to the Triangle? We make the landing soft.',
    img: '/images/home/relocating.webp', alt: 'Highway running through a residential area at sunrise' },
  { href: '/neighborhoods', label: 'Neighborhoods', desc: 'Explore communities across the Triangle.',
    img: '/images/home/neighborhoods.webp', alt: 'Tree-lined neighborhood sidewalk in fall color' },
  { href: '/about#team', label: 'Meet the Team', desc: 'Five decades of local expertise, one trusted group.',
    img: '/images/home/team.webp', alt: 'Team working together around a table' },
];
---

<BaseLayout title="Julie Wright Realty Group | Triangle Area Real Estate">

  <!-- ═══════════════════════════════════ HERO ═══════════════════════════════════ -->
  <section class="hero">
    <img src="/FallTopo_v2.svg" class="topo-bg topo-bg--light" alt="" aria-hidden="true" />
    <div class="relative content-wrap">
      <div class="hero-center">
        <p class="hero-eyebrow">Five Decades in the Triangle &middot; Raleigh, North Carolina</p>
        <img src="/JWRG_Full.svg" class="hero-logo" alt="Julie Wright Realty Group" />
        <h1 class="hero-tagline">Your place in the Triangle starts here.</h1>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════ FEATURED LISTINGS ═══════════════════════════════════ -->
  <section class="featured-section">
    <div class="content-wrap">
      <div class="featured-header">
        <div>
          <p class="section-label">Featured</p>
          <h2 class="featured-heading">Current Listings</h2>
        </div>
        <BtnArrow href="/listings" variant="primary">View All</BtnArrow>
      </div>
      {apiError ? (
        <p class="text-earth-600 text-center py-8">Listings are temporarily unavailable — please try again shortly.</p>
      ) : featuredListings.length === 0 ? (
        <p class="text-earth-600 text-center py-8">New listings are on the way. Check back soon.</p>
      ) : (
        <div class="featured-grid">
          {featuredListings.slice(0, 6).map((listing, i) => (
            <ListingCard listing={listing} index={i} />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ═══════════════════════════════════ HOW WE HELP ═══════════════════════════════════ -->
  <section class="home-about-services">
    <div class="content-wrap">
      <div class="home-help-grid">
        {helpLinks.map((item) => (
          <a href={item.href} class="home-help-card group">
            <div class="home-help-media">
              <img src={item.img} alt={item.alt} class="home-help-img" loading="lazy" decoding="async" />
            </div>
            <div class="home-help-body">
              <h3 class="home-help-title">{item.label}</h3>
              <p class="home-help-desc">{item.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════ SELLER CTA ═══════════════════════════════════ -->
  <section class="cta-feature">
    <div class="cta-wrap">
      <h2 class="cta-bold-heading">Thinking about selling?</h2>
      <p class="cta-bold-body">
        Get a free, no-obligation valuation and a market strategy tailored to your property.
      </p>
      <div class="cta-btn-row">
        <BtnArrow href="/resources/sellers/home-value" variant="inverted">Get Your Home's Value</BtnArrow>
        <BtnArrow href="/contact" variant="inverted">Talk to an Agent</BtnArrow>
      </div>
    </div>
  </section>

</BaseLayout>
