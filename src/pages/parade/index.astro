---
// FCHBA Parade of Homes 2026 landing page. Driven by the office Parade
// (`GET /parades/parade-of-homes-2026`): the communities (in the parade's own
// order), their entry counts, and the public dates/hours all come from the
// payload. Mirrors the neighborhoods index: the participating communities'
// logos centered over the topo background, with a parade-only version of the
// neighborhood map beside them. Cards and map chips link to /parade/{slug} —
// the parade view of each community — not the regular neighborhood page.
// SSR so office-side changes (entries, dates, logos, coords) show up without a
// redeploy; the caching middleware gives the HTML a short edge cache.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import MiniContactForm from '../../components/MiniContactForm.astro';
import NeighborhoodMap, { type MapPoint } from '../../components/NeighborhoodMap.astro';
import { fetchNeighborhoods, fetchParade, formatParadeDate, photoSrc, photoSrcSet } from '../../lib/api';
import { SEED_COORDS } from '../../data/neighborhoodCoords';
import { PARADE_SLUG, PARADE_TITLE } from '../../data/parade';

const [neighborhoods, parade] = await Promise.all([
  fetchNeighborhoods().catch(() => []),
  fetchParade(PARADE_SLUG),
]);

const title = parade?.name ?? PARADE_TITLE;

// The parade's communities, in its order, joined to the office neighborhood
// records (logos, coordinates). A community the office stops resolving drops out
// rather than 500ing.
const paradeNeighborhoods = (parade?.neighborhoods ?? [])
  .map((p) => {
    const n = neighborhoods.find((x) => x.slug === p.slug);
    return n ? { ...n, entry_count: p.entry_count } : null;
  })
  .filter((n): n is NonNullable<typeof n> => Boolean(n));

const dates = (parade?.dates ?? []).map(formatParadeDate);

const countWords = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const communityCount = paradeNeighborhoods.length;
const bannerDescription = !parade
  ? 'Parade details are coming soon.'
  : communityCount === 1
    ? "One of our communities is part of this year's Parade of Homes. See its featured homes."
    : `${countWords[communityCount] ?? communityCount} of our communities are part of this year's Parade of Homes. Pick a neighborhood to see its featured homes.`;

const isPlanned = (status: string | null | undefined) =>
  status === 'planning' || status === 'under_development';

const townLine = (n: { county: string | null; city: string | null }) =>
  [n.city, n.county && `${n.county} County`].filter(Boolean).join(' · ');

const points: MapPoint[] = paradeNeighborhoods
  .map((n) => {
    const seed = SEED_COORDS[n.slug];
    const lat = n.latitude ?? seed?.[0] ?? null;
    const lng = n.longitude ?? seed?.[1] ?? null;
    return { n, lat, lng };
  })
  .filter((p): p is { n: (typeof paradeNeighborhoods)[number]; lat: number; lng: number } => p.lat != null && p.lng != null)
  .map(({ n, lat, lng }) => ({
    slug: n.slug,
    name: n.name,
    lat,
    lng,
    logo: n.featured_image?.url ?? null,
    aspect: n.featured_image?.aspect ?? 1,
    town: townLine(n),
    planned: isPlanned(n.status),
    href: `/parade/${n.slug}`,
  }));
---

<BaseLayout
  title={`${title} | Julie Wright Realty Group`}
  description={`The communities Julie Wright Realty Group is showing in the ${title}, with the featured homes in each, plus the tour dates and hours.`}
>
  <PageBanner title={title} description={bannerDescription} />

  {parade && dates.length > 0 && (
    <section class="pt-8" aria-labelledby="parade-dates-heading">
      <div class="max-w-7xl mx-auto px-6">
        <div class="bg-earth-100/60 border border-earth-200/60 rounded-sm p-6 md:p-8 flex flex-col md:flex-row md:items-center gap-6">
          <div class="md:w-1/3">
            <h2 id="parade-dates-heading" class="font-display text-2xl text-earth-900">Tour Dates &amp; Hours</h2>
            {parade.organizer && (
              <p class="text-sm text-earth-600 mt-1">
                Presented by{' '}
                {parade.organizer_url ? (
                  <a href={parade.organizer_url} class="text-red-600 hover:text-red-700 underline underline-offset-2" target="_blank" rel="noopener">{parade.organizer}</a>
                ) : (
                  parade.organizer
                )}
              </p>
            )}
          </div>
          <ul class="md:flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-2 text-earth-900">
            {parade.dates.map((d, i) => (
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-red-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <time datetime={d.starts_at}>{dates[i]}</time>
              </li>
            ))}
          </ul>
        </div>
        <p class="text-xs text-earth-500 mt-2">All times Eastern.</p>
      </div>
    </section>
  )}

  <section class="py-8 pb-16">
    <!-- At lg+ the logo grid and the map share one row: cards in the left 3/4,
         a portrait map in the right 1/4 (below lg the map stacks underneath).
         The card row still caps at 3: the 3/4 column is ~916px at the 7xl cap,
         and three w-72 cards + two gap-x-4 gaps = 896px, so a fourth wraps;
         shorter rows center. -->
    <div class="max-w-7xl mx-auto px-6 grid gap-8 lg:grid-cols-4 items-start">
      {paradeNeighborhoods.length === 0 ? (
        <div class="text-center text-earth-600 py-16 lg:col-span-3">
          <p>{parade ? 'Parade communities are being finalized. Please check back soon.' : 'Parade details coming soon. Please check back shortly.'}</p>
        </div>
      ) : (
        <div class="lg:col-span-3 flex flex-wrap justify-center gap-x-4 -mb-6">
          {paradeNeighborhoods.map((n) => {
            const heroSrc = photoSrc(n.primary_photo, 800);
            // Alpha-preserving webp — several neighborhood "photos" are
            // transparent logos that jpg would flatten to a black matte.
            const heroWebp = photoSrcSet(n.primary_photo, 'webp');
            const logo = n.featured_image
              ? { src: n.featured_image.url, scale: n.featured_image.scale ?? undefined }
              : undefined;
            const logoPct = `${(logo?.scale ?? 1) * 100}%`;
            const count = n.entry_count;
            return (
              <a
                href={`/parade/${n.slug}`}
                aria-label={n.name}
                class="group flex flex-col mb-6 transition-transform duration-300 hover:-translate-y-1 w-72 max-w-full shrink-0"
              >
                <div class="aspect-[4/3] relative overflow-hidden rounded-sm">
                  {logo ? (
                    <div class="w-full h-full flex items-center justify-center px-8 py-0">
                      <img
                        src={logo.src}
                        alt={`${n.name} logo`}
                        class="w-auto h-auto object-contain origin-bottom transition-transform duration-300 group-hover:scale-[1.04]"
                        style={`max-width:${logoPct};max-height:${logoPct}`}
                        loading="lazy"
                      />
                    </div>
                  ) : heroSrc ? (
                    <picture class="contents">
                      {heroWebp && (
                        <source type="image/webp" srcset={heroWebp} sizes="(min-width:768px) 25vw, 100vw" />
                      )}
                      <img
                        src={heroSrc}
                        alt={n.primary_photo?.alt ?? n.name}
                        class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700"
                        loading="lazy"
                      />
                    </picture>
                  ) : (
                    <div class="w-full h-full flex items-center justify-center" aria-hidden="true">
                      <svg class="w-24 h-24 text-gold-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    </div>
                  )}
                </div>
                {/* The logo carries the community name (and the <a> has an
                    aria-label), so the label is just the parade-home count. */}
                <div class="flex items-center justify-center text-sm font-semibold text-earth-800">
                  <span>{`${count} Home${count === 1 ? '' : 's'}`}</span>
                </div>
              </a>
            );
          })}
        </div>
      )}

      {points.length > 0 && (
        <div class="lg:col-span-1">
          <NeighborhoodMap
            points={points}
            ariaLabel="Interactive map of the Parade of Homes communities"
            heightStyle="height: 480px;"
          />
        </div>
      )}
    </div>
  </section>

  <MiniContactForm />
</BaseLayout>
