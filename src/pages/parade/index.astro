---
// FCHBA Parade of Homes 2026 — hidden landing page (no nav/footer link, not in
// the sitemap, noindex until launch). Mirrors the neighborhoods index: the
// participating communities' logos centered over the topo background, with a
// parade-only version of the neighborhood map below. Cards and map chips link
// to /parade/{slug} — the parade view of each community — not the regular
// neighborhood page.
// SSR so office-side changes (logos, coords, newly tagged homes) show up
// without a redeploy; the caching middleware gives the HTML a short edge cache.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import MiniContactForm from '../../components/MiniContactForm.astro';
import NeighborhoodMap, { type MapPoint } from '../../components/NeighborhoodMap.astro';
import { fetchNeighborhoods, fetchListingsByTag, photoSrc, photoSrcSet } from '../../lib/api';
import { SEED_COORDS } from '../../data/neighborhoodCoords';
import { PARADE_SLUGS, PARADE_TAG, PARADE_TITLE } from '../../data/parade';

const [neighborhoods, paradeListings] = await Promise.all([
  fetchNeighborhoods().catch(() => []),
  fetchListingsByTag(PARADE_TAG),
]);

// Keep the user-facing order of PARADE_SLUGS, dropping any slug the office no
// longer resolves.
const paradeNeighborhoods = PARADE_SLUGS.map((slug) =>
  neighborhoods.find((n) => n.slug === slug),
).filter((n): n is NonNullable<typeof n> => Boolean(n));

// Per-community count of tagged parade homes (one API call for the whole page).
const paradeCounts = new Map<string, number>();
for (const l of paradeListings) {
  const slug = l.neighborhood?.slug;
  if (slug) paradeCounts.set(slug, (paradeCounts.get(slug) ?? 0) + 1);
}

const isPlanned = (status: string | null | undefined) =>
  status === 'planning' || status === 'under_development';

const townLine = (n: { county: string | null; city: string | null }) =>
  [n.city, n.county && `${n.county} County`].filter(Boolean).join(' · ');

const points: MapPoint[] = paradeNeighborhoods
  .map((n) => {
    const seed = SEED_COORDS[n.slug];
    const lat = n.latitude ?? seed?.[0] ?? null;
    const lng = n.longitude ?? seed?.[1] ?? null;
    return { n, lat, lng };
  })
  .filter((p): p is { n: (typeof paradeNeighborhoods)[number]; lat: number; lng: number } => p.lat != null && p.lng != null)
  .map(({ n, lat, lng }) => ({
    slug: n.slug,
    name: n.name,
    lat,
    lng,
    logo: n.featured_image?.url ?? null,
    aspect: n.featured_image?.aspect ?? 1,
    town: townLine(n),
    planned: isPlanned(n.status),
    href: `/parade/${n.slug}`,
  }));
---

<BaseLayout
  title={`${PARADE_TITLE} | Julie Wright Realty Group`}
  description="The communities Julie Wright Realty Group is showing in the 2026 Parade of Homes, with the featured homes in each."
  noindex
>
  <PageBanner
    title={PARADE_TITLE}
    description="Five of our communities are part of this year's Parade of Homes. Pick a neighborhood to see its featured homes."
  />

  <section class="py-8">
    <div class="max-w-7xl mx-auto px-6">
      {paradeNeighborhoods.length === 0 ? (
        <div class="text-center text-earth-600 py-16">
          <p>Parade communities are being finalized. Please check back soon.</p>
        </div>
      ) : (
        <div class="flex flex-wrap justify-center gap-x-6 -mb-6">
          {paradeNeighborhoods.map((n) => {
            const heroSrc = photoSrc(n.primary_photo, 800);
            // Alpha-preserving webp — several neighborhood "photos" are
            // transparent logos that jpg would flatten to a black matte.
            const heroWebp = photoSrcSet(n.primary_photo, 'webp');
            const logo = n.featured_image
              ? { src: n.featured_image.url, scale: n.featured_image.scale ?? undefined }
              : undefined;
            const logoPct = `${(logo?.scale ?? 1) * 100}%`;
            const count = paradeCounts.get(n.slug) ?? 0;
            return (
              <a
                href={`/parade/${n.slug}`}
                aria-label={n.name}
                class="group flex flex-col mb-6 transition-transform duration-300 hover:-translate-y-1 w-72 max-w-full shrink-0"
              >
                <div class="aspect-[4/3] relative overflow-hidden rounded-sm">
                  {logo ? (
                    <div class="w-full h-full flex items-center justify-center px-8 py-0">
                      <img
                        src={logo.src}
                        alt={`${n.name} logo`}
                        class="w-auto h-auto object-contain origin-bottom transition-transform duration-300 group-hover:scale-[1.04]"
                        style={`max-width:${logoPct};max-height:${logoPct}`}
                        loading="lazy"
                      />
                    </div>
                  ) : heroSrc ? (
                    <picture class="contents">
                      {heroWebp && (
                        <source type="image/webp" srcset={heroWebp} sizes="(min-width:768px) 25vw, 100vw" />
                      )}
                      <img
                        src={heroSrc}
                        alt={n.primary_photo?.alt ?? n.name}
                        class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700"
                        loading="lazy"
                      />
                    </picture>
                  ) : (
                    <div class="w-full h-full flex items-center justify-center" aria-hidden="true">
                      <svg class="w-24 h-24 text-gold-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    </div>
                  )}
                </div>
                <div class="flex items-center justify-center gap-2 text-sm font-semibold text-earth-800">
                  <span>{n.name}</span>
                  {count > 0 && (
                    <Fragment>
                      <span aria-hidden="true">·</span>
                      <span>{`${count} parade home${count === 1 ? '' : 's'}`}</span>
                    </Fragment>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>

  {points.length > 0 && (
    <section class="pb-16">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="font-display text-2xl text-earth-900 mb-4 text-center">Find them on the map</h2>
        <NeighborhoodMap
          points={points}
          ariaLabel="Interactive map of the Parade of Homes communities"
        />
      </div>
    </section>
  )}

  <MiniContactForm />
</BaseLayout>
