---
import { site } from '../data/site';
import { photoSrc, type ApiTeamMember } from '../lib/api';
import EmbedForm from './EmbedForm.astro';

interface Props {
  heading?: string;
  description?: string;
  /**
   * Subject/routing ids, forwarded to EmbedForm so the office can attribute the
   * lead and route it (a neighborhood enquiry → that community's round-robin, an
   * agent page → that agent). These MUST be declared and passed through: Astro
   * silently discards props a component doesn't accept, so when they were
   * missing here the callers' `neighborhoodId={n.id}` vanished without any
   * error and every lot/neighborhood lead fell back to the general pool.
   */
  listingId?: string;
  agentId?: string;
  neighborhoodId?: string;
  /**
   * Neighborhood agents to show instead of the brokerage phone/email/office
   * block. Display only — routing still goes through neighborhoodId, because
   * the office treats `list_on_website` and round-robin intake as separate
   * flags. Empty or omitted falls back to the brokerage block.
   */
  agents?: ApiTeamMember[];
}

const {
  heading = "Questions? We'd Love to Hear from You",
  description = "Whether you're buying, selling, or just exploring your options, our team is here to help. Reach out and let us put five decades of experience to work for you.",
  listingId,
  agentId,
  neighborhoodId,
  agents = [],
} = Astro.props;

const hasAgents = agents.length > 0;

// One agent shown → route the lead to them by name. The visitor read that
// single name and expects that person, so an anonymous round-robin would be a
// surprise. With two or more shown there's no one obvious recipient, so it
// falls through to the neighborhood's round-robin. An agentId passed explicitly
// by the page (the agent profile page) always wins.
const resolvedAgentId = agentId ?? (agents.length === 1 ? String(agents[0].id) : undefined);

const formToken = site.formTokens.miniContact || site.formTokens.contact;
---

<section class="py-12 lg:py-16 relative">
  <div class="content-wrap">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      <!-- Info -->
      <div>
        <p class="section-label">Contact</p>
        <h2 class="section-heading">{heading}</h2>
        <p class="text-earth-600 leading-relaxed mt-4 mb-8">{description}</p>

        {hasAgents ? (
          <div class="space-y-4">
            {agents.map((a) => (
              <div class="flex items-start gap-4">
                {photoSrc(a.primary_photo, 400) ? (
                  <img
                    src={photoSrc(a.primary_photo, 400)}
                    alt={a.name}
                    width="56"
                    height="56"
                    loading="lazy"
                    class="w-14 h-14 rounded-sm object-cover shrink-0 bg-earth-100"
                  />
                ) : (
                  <div class="w-14 h-14 rounded-sm bg-earth-100 text-red-600 flex items-center justify-center shrink-0 font-display">
                    {a.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}
                  </div>
                )}
                <div class="min-w-0">
                  <a href={`/about/team/${a.slug}`} class="font-display text-earth-900 hover:text-red-600 transition-colors">{a.name}</a>
                  {a.title && <div class="text-sm text-earth-500">{a.title}</div>}
                  <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                    {a.public_phone && (
                      <a href={`tel:${a.public_phone.replace(/[^0-9]/g, '')}`} class="text-earth-600 hover:text-red-600 transition-colors">{a.public_phone}</a>
                    )}
                    {a.public_email && (
                      <a href={`mailto:${a.public_email}`} class="text-earth-600 hover:text-red-600 transition-colors break-all">{a.public_email}</a>
                    )}
                  </div>
                </div>
              </div>
            ))}
            <p class="text-sm text-earth-500 pt-1">
              Or reach the office at
              <a href={`tel:${site.phoneRaw}`} class="text-red-600 hover:underline">{site.phone}</a>.
            </p>
          </div>
        ) : (
        <div class="space-y-5">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-sm bg-earth-100 text-red-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <div class="font-display text-earth-900">Phone</div>
              <a href={`tel:${site.phoneRaw}`} class="text-earth-600 hover:text-red-600 transition-colors">{site.phone}</a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-sm bg-earth-100 text-red-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <div class="font-display text-earth-900">Email</div>
              <a href={`mailto:${site.email}`} class="text-earth-600 hover:text-red-600 transition-colors">{site.email}</a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-sm bg-earth-100 text-red-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <div class="font-display text-earth-900">Office</div>
              <p class="text-earth-600">{site.address.street1}, {site.address.street2}<br />{site.address.city}, {site.address.state} {site.address.zip}</p>
            </div>
          </div>
        </div>
        )}
      </div>

      <!-- Form -->
      <div class="bg-white rounded-sm p-8 md:p-10">
        <h3 class="contact-form-heading">Send Us a Message</h3>
        {formToken ? (
          <EmbedForm id="jwrg-mini-contact" token={formToken} listingId={listingId} agentId={resolvedAgentId} neighborhoodId={neighborhoodId} />
        ) : (
          <p class="text-earth-600 leading-relaxed">
            Our online contact form is being configured. In the meantime, please reach us
            by <a href={`tel:${site.phoneRaw}`} class="text-red-600 hover:underline">phone</a>
            or <a href={`mailto:${site.email}`} class="text-red-600 hover:underline">email</a>.
          </p>
        )}
      </div>
    </div>
  </div>
</section>
