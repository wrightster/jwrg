---
// Up-one-level link. `href`/`label` name the PARENT page, not this one.
// Bare inline element — the row/gutter is owned by ResourceNav.
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a
  href={href}
  class="group inline-flex items-center gap-1.5 text-sm font-display text-earth-600 hover:text-red-600 transition-colors"
>
  <svg
    class="w-4 h-4 transition-transform group-hover:-translate-x-1"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
  </svg>
  Back to {label}
</a>
