---
// In-page document viewer (front-end port of the back office's preview
// modal): any `<a data-doc-viewer data-doc-title="…" data-doc-mime="…">`
// link on the page opens here instead of navigating. PDFs and images render
// inline via `?inline=1` on the office download URL (the office only serves
// inline-safe mimes that way — scriptable types always download); everything
// else gets a download panel. Include the component once per page that
// renders document links.
---

<div
  id="doc-viewer"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-8"
  role="dialog"
  aria-modal="true"
  aria-labelledby="dv-title"
>
  <div id="dv-backdrop" class="absolute inset-0 bg-earth-950/80"></div>
  <div class="relative z-10 flex flex-col w-full max-w-5xl h-[88vh] bg-white rounded-sm shadow-2xl overflow-hidden">
    <div class="flex items-center gap-3 px-4 sm:px-6 py-3 border-b border-earth-200 bg-earth-50">
      <h2 id="dv-title" class="font-display text-base sm:text-lg text-earth-900 truncate min-w-0 flex-1"></h2>
      <a
        id="dv-open"
        href="#"
        target="_blank"
        rel="noopener"
        class="shrink-0 inline-flex items-center gap-1.5 text-sm text-earth-700 hover:text-red-600 transition-colors"
        aria-label="Open in new tab"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
        <span class="hidden sm:inline">Open</span>
      </a>
      <a
        id="dv-download"
        href="#"
        class="shrink-0 inline-flex items-center gap-1.5 text-sm text-earth-700 hover:text-red-600 transition-colors"
        aria-label="Download"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
        <span class="hidden sm:inline">Download</span>
      </a>
      <button
        type="button"
        id="dv-close"
        class="shrink-0 inline-flex items-center justify-center w-8 h-8 text-earth-500 hover:text-earth-900 transition-colors"
        aria-label="Close viewer"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="dv-body" class="flex-1 min-h-0 bg-earth-100"></div>
  </div>
</div>

<script>
  const viewer = document.getElementById('doc-viewer');
  const dvBody = document.getElementById('dv-body');
  const dvTitle = document.getElementById('dv-title');
  const dvOpen = document.getElementById('dv-open') as HTMLAnchorElement | null;
  const dvDownload = document.getElementById('dv-download') as HTMLAnchorElement | null;
  const dvClose = document.getElementById('dv-close');
  let dvTrigger: HTMLElement | null = null;

  const inlineUrl = (url: string) => url + (url.includes('?') ? '&' : '?') + 'inline=1';

  function openViewer(link: HTMLAnchorElement) {
    if (!viewer || !dvBody) return;
    const url = link.href;
    const mime = link.getAttribute('data-doc-mime') ?? '';
    const title = link.getAttribute('data-doc-title') ?? 'Document';
    dvTrigger = link;

    if (dvTitle) dvTitle.textContent = title;
    if (dvDownload) dvDownload.href = url;

    dvBody.innerHTML = '';

    if (mime === 'application/pdf') {
      if (dvOpen) dvOpen.href = inlineUrl(url);
      const frame = document.createElement('iframe');
      frame.src = inlineUrl(url);
      frame.title = title;
      frame.className = 'w-full h-full border-0';
      dvBody.appendChild(frame);
    } else if (mime.startsWith('image/')) {
      if (dvOpen) dvOpen.href = inlineUrl(url);
      const wrap = document.createElement('div');
      wrap.className = 'w-full h-full flex items-center justify-center p-4';
      const img = document.createElement('img');
      img.src = inlineUrl(url);
      img.alt = title;
      img.className = 'max-w-full max-h-full object-contain';
      wrap.appendChild(img);
      dvBody.appendChild(wrap);
    } else {
      if (dvOpen) dvOpen.href = url;
      const panel = document.createElement('div');
      panel.className = 'w-full h-full flex flex-col items-center justify-center gap-4 text-center p-8';
      panel.innerHTML =
        '<svg class="w-12 h-12 text-earth-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/></svg>' +
        '<p class="text-earth-700">This file type can’t be previewed in the browser.</p>';
      const btn = document.createElement('a');
      btn.href = url;
      btn.className = 'inline-flex items-center gap-2 px-6 py-3 rounded-sm border-2 border-earth-900 text-earth-900 hover:bg-earth-900 hover:text-earth-50 font-semibold transition-all text-sm';
      btn.textContent = 'Download';
      panel.appendChild(btn);
      dvBody.appendChild(panel);
    }

    viewer.classList.remove('hidden');
    viewer.classList.add('flex');
    document.body.style.overflow = 'hidden';
    dvClose?.focus();
  }

  function closeViewer() {
    if (!viewer || !dvBody) return;
    viewer.classList.add('hidden');
    viewer.classList.remove('flex');
    dvBody.innerHTML = '';
    document.body.style.overflow = '';
    dvTrigger?.focus();
    dvTrigger = null;
  }

  document.querySelectorAll<HTMLAnchorElement>('a[data-doc-viewer]').forEach((link) => {
    link.addEventListener('click', (e) => {
      // Let modified clicks (new tab, download) behave natively.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      openViewer(link);
    });
  });

  dvClose?.addEventListener('click', closeViewer);
  document.getElementById('dv-backdrop')?.addEventListener('click', closeViewer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && viewer && !viewer.classList.contains('hidden')) closeViewer();
  });
</script>
