---
// Server island (used with `server:defer`): the neighborhoods grid renders live
// from the office API. Deferring it lets the /neighborhoods shell prerender and
// paint instantly, then the cards stream in behind their skeleton fallback.
//
// This also moves the per-card lot-count fan-out (the N+1 below) off the page's
// critical path — the shell no longer waits on `fetchNeighborhoods()` plus one
// `fetchNeighborhoodLots()` per lot-based neighborhood. No client script here,
// so it's safe inside an island.
import { fetchNeighborhoods, fetchNeighborhoodLots, photoSrc, photoSrcSet } from '../lib/api';

// The office API returns neighborhoods in their manual display order (the
// `sort` column — editable by drag-and-drop or a number field in the back
// office; see the office NeighborhoodController index). Render in that order.
const neighborhoods = await fetchNeighborhoods().catch(() => []);

// Each card carries a single lifecycle tag — "Active" (red) or "Planned"
// (gold) — plus one inventory number. Office statuses that mean "not yet
// selling" (planning / under_development) read as Planned; everything live
// (active_sales / sold_out / established / unset) reads as Active.
const plannedStatuses = new Set(['planning', 'under_development']);

// Enrich each neighborhood with its display tag + inventory count. Available
// listings win; only fall back to a live lot count for neighborhoods that have
// no available listings (so lot-based communities still show a number).
const cards = await Promise.all(
  neighborhoods.map(async (n) => {
    const listings = n.listings_count ?? 0;
    let count = listings;
    let unit: 'listing' | 'lot' = 'listing';
    if (listings === 0) {
      const lots = await fetchNeighborhoodLots(n.slug).catch(() => []);
      count = lots.filter((l) => l.status === 'available').length;
      unit = 'lot';
    }
    const planned = plannedStatuses.has(n.status ?? '');
    return { n, count, unit, planned };
  }),
);
---

{cards.length === 0 ? (
  <div class="text-center text-earth-600 py-16">
    <p>No neighborhoods are available right now. Please check back soon.</p>
  </div>
) : (
  <div class="flex flex-wrap justify-center gap-x-6 -mb-6">
    {cards.map(({ n, count, unit, planned }, i) => {
      // Staggered rows at EVERY breakpoint: each row alternates between the
      // breakpoint's column count and one less, offset like brickwork. Every
      // card is a FIXED width (w-72) — it never scales with the viewport;
      // extra width just grows the side margins (justify-center + the
      // max-w-7xl wrapper), the same way the grid already behaved past its
      // full-width cap. The breakpoint only changes how many fixed cards fit
      // per row: xl → 3,4,3,4 · lg → 2,3,2,3 · md → 1,2,1,2 · base → 1–2.
      // Shorter rows don't fill the width and center; full rows fill it.
      // Zero-height, full-width spacers force the wrap at each row's end —
      // fixed-width cards would otherwise just pack as many as fit. Break
      // positions differ per breakpoint (the [n-1,n] cycle length is 3 / 5
      // / 7 for md / lg / xl), so each card renders up to three spacers,
      // each scoped to a single breakpoint band. Vertical rhythm comes from
      // each card's mb-6 (not a row-gap) so the spacer lines add no space.
      const breakMd = i % 3 === 0 || i % 3 === 2; // md band: 1,2 cycle
      const breakLg = i % 5 === 1 || i % 5 === 4; // lg band: 2,3 cycle
      const breakXl = i % 7 === 2 || i % 7 === 6; // xl band: 3,4 cycle
      const heroSrc = photoSrc(n.primary_photo, 800);
      // Prefer the alpha-preserving webp: several neighborhood "photos" are
      // actually transparent logos, and the jpg conversion flattens them to
      // a black matte. webp keeps transparency so they sit on the light
      // card background instead.
      const heroWebp = photoSrcSet(n.primary_photo, 'webp');
      // Some neighborhoods display a brand logo (over the site background)
      // instead of an API photo — the office-managed featured image, which
      // rides on the neighborhood record, so slug renames can't orphan it.
      // Manage it on the office's neighborhood Details tab (or via MCP).
      const logo = n.featured_image
        ? { src: n.featured_image.url, scale: n.featured_image.scale ?? undefined }
        : undefined;
      const logoPct = `${(logo?.scale ?? 1) * 100}%`;
      return (
        <Fragment>
        <a
          href={`/neighborhoods/${n.slug}`}
          aria-label={n.name}
          class="group flex flex-col mb-6 transition-transform duration-300 hover:-translate-y-1 w-72 max-w-full shrink-0"
        >
          <div class="aspect-[4/3] relative overflow-hidden rounded-sm">
            {logo ? (
              <div class="w-full h-full flex items-center justify-center px-8 py-0">
                <img
                  src={logo.src}
                  alt={`${n.name} logo`}
                  class="w-auto h-auto object-contain origin-bottom transition-transform duration-300 group-hover:scale-[1.04]"
                  style={`max-width:${logoPct};max-height:${logoPct}`}
                  loading="lazy"
                />
              </div>
            ) : heroSrc ? (
              <picture class="contents">
                {heroWebp && (
                  <source type="image/webp" srcset={heroWebp} sizes="(min-width:1280px) 25vw, (min-width:1024px) 33vw, (min-width:768px) 50vw, 100vw" />
                )}
                <img
                  src={heroSrc}
                  alt={n.primary_photo?.alt ?? n.name}
                  class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700"
                  loading="lazy"
                />
              </picture>
            ) : (
              <div class="w-full h-full flex items-center justify-center" aria-hidden="true">
                <svg class="w-24 h-24 text-gold-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              </div>
            )}
          </div>
          <div class="flex items-center justify-center gap-2 text-sm font-semibold text-earth-800">
            <span>{planned ? 'Planned' : 'Active'}</span>
            {count > 0 && (
              <Fragment>
                <span aria-hidden="true">·</span>
                <span>{count} {unit}{count === 1 ? '' : 's'}</span>
              </Fragment>
            )}
          </div>
        </a>
        {breakMd && (
          <div class="hidden md:block lg:hidden basis-full h-0" aria-hidden="true"></div>
        )}
        {breakLg && (
          <div class="hidden lg:block xl:hidden basis-full h-0" aria-hidden="true"></div>
        )}
        {breakXl && (
          <div class="hidden xl:block basis-full h-0" aria-hidden="true"></div>
        )}
        </Fragment>
      );
    })}
  </div>
)}
