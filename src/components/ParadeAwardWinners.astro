---
// The parade's award winners (office `award` on each entry), gold first, as
// listing cards headed by the builder's name (centered) and medal-coloured
// labels naming the award and the parade (the card's own on-image badge is
// hidden — the header replaces it). A home that also won in another organizer's parade (Triangle
// as well as Franklin County) gets a label for each award, this parade's first.
// Leads the /parade page; renders nothing until judging is recorded.
import ListingCard from './ListingCard.astro';
import { paradeAwardClass, paradeBadgeLabel, paradeBadges, type ApiParadeEntry } from '../lib/api';
import { awardWinners } from '../data/parade';

interface Props {
  entries: ApiParadeEntry[];
  title: string;
  /** This parade's slug — its award leads each winner's labels. */
  slug: string;
}

const { entries, title, slug } = Astro.props;
const winners = awardWinners(entries);
---

{winners.length > 0 && (
  <section class="pt-10" aria-labelledby="parade-awards-heading">
    <div class="max-w-7xl mx-auto px-6">
      <h2 id="parade-awards-heading" class="font-display text-3xl text-earth-900 mb-8">{title} Award Winners</h2>
      <div class="featured-grid">
        {winners.map((e, i) => {
          const listing = e.listing!;
          const badges = paradeBadges(listing);
          const own = badges.find((b) => b.slug === slug);
          const builder = e.builder ?? own?.builder ?? listing.parade?.builder ?? null;
          // This parade's award (the entry is authoritative), then any others.
          const awards = [
            { slug, award: e.award ?? null, short_name: own?.short_name ?? null, entry_number: null },
            ...badges.filter((b) => b.slug !== slug && b.award),
          ];
          return (
            <div class="parade-award-winner">
              {builder && <p class="parade-award-builder">{builder.name}</p>}
              <div class="parade-award-labels">
                {awards.map((a) => (
                  <p class:list={['parade-badge parade-award-label', paradeAwardClass(a.award)]}>
                    <span>{paradeBadgeLabel(a)}</span>
                  </p>
                ))}
              </div>
              {/* The header above carries the awards, so the card skips its own badge. */}
              <ListingCard listing={listing} index={i} paradeBadge={false} />
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
